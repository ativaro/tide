    "after_catch": "use readings\n\nfirst_invalid rows:*t > ?i\ncatch E_DATA\n  (fold rows (nil i) ok row line (let value (reading line row) ok))\n  problem (if (has_reason problem \"invalid_integer\") (input_line problem) (raise problem))\n\nexample all_valid first_invalid\n{\"inputs\":{\"rows\":[\"-9\",\"0\",\"9223372036854775807\"]},\"expect\":{\"none\":true}}\n\nexample first_bad first_invalid\n{\"inputs\":{\"rows\":[\"4\",\"x\",\"-\",\"9\"]},\"expect\":{\"some\":2}}\n\nexample empty first_invalid\n{\"inputs\":{\"rows\":[]},\"expect\":{\"none\":true}}\n",
    "readings": "reading line:t row:i > i\nneed int line \"invalid_integer\" row\n\nhigher value:i previous:?i > ?i\nsome case previous value old if > value old value old\n",
    "cpython": "import json\nimport sys\n\ndef first_invalid(rows):\n    if type(rows) is not list or len(rows) > 4096 or any(type(s) is not str for s in rows):\n        raise ValueError(\"invalid rows\")\n    for row, text in enumerate(rows, 1):\n        digits = text.removeprefix(\"-\")\n        if not (digits.isascii() and digits.isdecimal()):\n            return {\"some\": row}\n        magnitude = digits.lstrip(\"0\") or \"0\"\n        limit = \"9223372036854775808\" if text.startswith(\"-\") else \"9223372036854775807\"\n        if len(magnitude) > 19 or (len(magnitude) == 19 and magnitude > limit):\n            return {\"some\": row}\n    return {\"none\": True}\n\nprint(json.dumps(first_invalid(**json.loads(sys.argv[1])), separators=(\",\", \":\")))\n"
  },
