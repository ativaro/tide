    "locator": {
      "contract": "Given an origin and a list of coordinates, return the coordinate at minimum absolute distance. If several coordinates are equally near, return the smallest coordinate. Empty input returns the origin. Coordinates are integers between -10000 and 10000 inclusive.",
      "target": "locate",
      "tide": {
        "panel.tide": "use choice\n\nlocate origin:i marks:*i > i\ncase (at marks 0) origin initial (fold marks initial current row item (choose origin current item))\n",
        "choice.tide": "use geometry\n\nchoose origin:i current:i item:i > i\nlet old distance origin current\nlet fresh distance origin item\nif (< fresh old) item (if (eq fresh old) (if (> item current) item current) current)\n",
        "geometry.tide": "distance origin:i mark:i > i\nlet delta - mark origin\nif (< delta 0) (- 0 delta) delta\n\nseparation a:i b:i > b\n< a b\n"
      },
      "python": {
        "panel.py": "from choice import choose\n\ndef locate(origin, marks):\n    if not marks:\n        return origin\n    current = marks[0]\n    for item in marks:\n        current = choose(origin, current, item)\n    return current\n",
        "choice.py": "from geometry import distance\n\ndef choose(origin, current, item):\n    old = distance(origin, current)\n    fresh = distance(origin, item)\n    if fresh < old:\n        return item\n    if fresh == old:\n        return item if item > current else current\n    return current\n",
        "geometry.py": "def distance(origin, mark):\n    delta = mark - origin\n    return -delta if delta < 0 else delta\n\ndef separation(a, b):\n    return a < b\n"
      },
