    "dial": {
      "contract": "Given a reading, a reference and a positive spacing, return the closest grid value reference + k * spacing for integer k. If a reading is exactly halfway between two grid values, choose the grid value farther from the reference. Inputs are integers: reading and reference in [-10000,10000], spacing in [1,100].",
      "target": "display",
      "tide": {
        "panel.tide": "use scale\n\ndisplay reading:i reference:i spacing:i > i\n+ reference (scale (- reading reference) spacing)\n",
        "scale.tide": "use units\n\nscale delta:i width:i > i\nlet magnitude if (< delta 0) (- 0 delta) delta\nlet rounded * width (units magnitude width)\nif (< delta 0) (- 0 rounded) rounded\n",
        "units.tide": "units magnitude:i width:i > i\nlet whole div magnitude width\nlet rest mod magnitude width\nif (< rest (div width 2)) whole (+ whole 1)\n\nmultiple value:i width:i > b\neq (mod value width) 0\n"
      },
      "python": {
        "panel.py": "from scale import scale\n\ndef display(reading, reference, spacing):\n    return reference + scale(reading - reference, spacing)\n",
        "scale.py": "from units import units\n\ndef scale(delta, width):\n    magnitude = -delta if delta < 0 else delta\n    rounded = width * units(magnitude, width)\n    return -rounded if delta < 0 else rounded\n",
        "units.py": "def units(magnitude, width):\n    whole = magnitude // width\n    rest = magnitude % width\n    return whole if rest < width // 2 else whole + 1\n\ndef multiple(value, width):\n    return value % width == 0\n"
      },
