record NativeCase
name:t source:t expected:t

native_case name:t step:t initial:t items:t expected:t > {NativeCase}
let header "apply initial:i xs:*i > i\n(fold xs initial a row x\n  "
let entry ")\n\nmain > i\n(apply "
make NativeCase name name source (concat header (concat step (concat entry (concat initial (concat " (list i " (concat items "))\n")))))) expected expected

main > *{NativeCase}
