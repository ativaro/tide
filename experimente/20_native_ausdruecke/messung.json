  "elf_headers": "\nElf file type is EXEC (Executable file)\nEntry point 0x4000b0\nThere are 2 program headers, starting at offset 64\n\nProgram Headers:\n  Type           Offset   VirtAddr           PhysAddr           FileSiz  MemSiz   Flg Align\n  LOAD           0x000000 0x0000000000400000 0x0000000000400000 0x00026d 0x00026d R E 0x1000\n  GNU_STACK      0x000000 0x0000000000000000 0x0000000000000000 0x000000 0x000000 RW  0x10\n",
  "method": {
    "cpython": "import sys\n\nMAX = 9223372036854775807\nREADINGS = (18, 20, 12, 14, 17, 21, 19, 18, 15, 11, 9, 18, 22, 14, 13, 19)\n\n\ndef degree_hours(initial, readings):\n    total = initial\n    for temperature in readings:\n        if temperature < 18:\n            deficit = 18 - temperature\n            if deficit > MAX:\n                raise OverflowError\n            total += deficit\n            if total > MAX:\n                raise OverflowError\n    return total\n\n\nif __name__ == \"__main__\":\n    repetitions = int(sys.argv[1]) if len(sys.argv) > 1 else 1\n    for _ in range(repetitions):\n        result = degree_hours(0, READINGS)\n    print(result)\n",
    "performance": "import hashlib\nimport itertools\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nfrom statistics import median\nimport struct\nimport subprocess\nimport sys\nimport time\n\nw = Path(sys.argv[1])\nrepo = Path.cwd()\nsource = repo / 'apps/heating.tide'\nexe = str(repo / 'tide')\ncpu = 2\nos.sched_setaffinity(0, {cpu})\ndef checked(cmd):\n    return subprocess.run(cmd, capture_output=True, check=True).stdout\ndef build(count):\n    checked([exe, 'check', str(source)])\n    if count == 1:\n        cmd = [exe, 'run', 'native/fold_i64.tide', '--read', 'source='+str(source)]\n    else:\n        cmd = [exe, 'run', 'native/fold_i64.tide', '--call', 'compile_repeated',\n               '--inputs', json.dumps({'source':source.read_text(), 'repetitions':count})]\n    path = w / ('heating-'+str(count))\n    path.write_bytes(bytes.fromhex(json.loads(checked(cmd))))\n    path.chmod(0o700)\n    return path\ndef timed(cmd):\n    start = time.perf_counter_ns()\n    data = checked(cmd)\n    duration = time.perf_counter_ns() - start\n    assert data == b'39\\n', (cmd,data)\n    return duration\n\nbuilds = []\nfor rep in range(-2,10):\n    start = time.perf_counter_ns()\n    binary = build(1)\n    elapsed = time.perf_counter_ns() - start\n    if rep >= 0: builds.append(elapsed)\nshort,long = 32768,131072\nbins = {1:binary,short:build(short),long:build(long)}\nimages = {}\nfor count,path in bins.items():\n    data=path.read_bytes()\n    # The wrapper loads RSI RIP-relative and calls the fold kernel immediately afterwards.\n    lea = data.index(bytes.fromhex('488d35'),176)\n    call = lea+7\n    assert data[call]==0xe8\n    start = call+5+struct.unpack_from('<i',data,call+1)[0]\n    stop = lea+7+struct.unpack_from('<i',data,lea+3)[0]\n    assert start<stop and stop==len(data)-16*8\n    images[count] = dict(image_bytes=len(data),sha256=hashlib.sha256(data).hexdigest(),kernel_start=start,kernel_end=stop,\n                         kernel_sha256=hashlib.sha256(data[start:stop]).hexdigest(),data_sha256=hashlib.sha256(data[stop:]).hexdigest())\nassert len({i['kernel_sha256'] for i in images.values()})==1\nassert len({i['data_sha256'] for i in images.values()})==1\npy = [sys.executable,'-B',str(w/'comparator.py')]\ncommands = {'native':[binary], 'python':py}\ncold = []\nfor rep in range(-6,30):\n    order = list(commands)[::1 if rep%2==0 else -1]\n    values={k:timed(commands[k]) for k in order}\n    cold.append(dict(rep=rep,ns=values))\ncommands={f'{lang}-{n}':([bins[n]] if lang=='native' else py+[str(n)]) for lang in ('native','python') for n in (short,long)}\norders = list(itertools.permutations(commands))\nwarm = []\nfor rep in range(-4,24):\n    values={k:timed(commands[k]) for k in orders[rep%24]}\n    slope={lang:(values[f'{lang}-{long}']-values[f'{lang}-{short}'])/(long-short) for lang in ('native','python')}\n    warm.append(dict(rep=rep,ns=values,ns_per_call=slope))\ncs = [e['ns'] for e in cold if e['rep']>=0]\nws = [e['ns_per_call'] for e in warm if e['rep']>=0]\ndef stats(data):\n    ratios = [e['python']/e['native'] for e in data if e['native']!=0]\n    return dict(native_ns=median(e['native'] for e in data),python_ns=median(e['python'] for e in data),median_paired_ratio=median(ratios),\n                ratio_range=[min(ratios),max(ratios)],nonpositive_pairs=sum(min(e.values())<=0 for e in data))\nresult=dict(cpu=cpu,platform=platform.platform(),python=platform.python_version(),short=short,long=long,images=images,\n            build_ns=builds,build_median_ns=median(builds),cold=cold,warm=warm,cold_summary=stats(cs),warm_summary=stats(ws))\n(w/'performance.json').write_text(json.dumps(result,indent=2)+'\\n')\nprint(result['cold_summary'],result['warm_summary'],result['build_median_ns'])\n",
    "differential_checks": "#!/usr/bin/env bash\nset -euo pipefail\nrepo=$PWD\nw=$(cd \"$(dirname \"$0\")\" && pwd)\n\"$repo/tide\" run experimente/20_native_ausdruecke/faelle.tide > \"$w/cases.json\"\njq -c '.[]' \"$w/cases.json\" | while read -r trial; do\n  name=$(jq -r .name <<< \"$trial\"); expected=$(jq -r .expected <<< \"$trial\")\n  d=\"$w/$name\"; mkdir -p \"$d\"; jq -jr .source <<< \"$trial\" > \"$d/source.tide\"\n  \"$repo/tide\" check \"$d/source.tide\" >/dev/null\n  \"$repo/tide\" run native/fold_i64.tide --read source=\"$d/source.tide\" | jq -ejr . | xxd -r -p > \"$d/main\"\n  chmod u+x \"$d/main\"\n  r=0; \"$repo/tide\" run \"$d/source.tide\" > \"$d/ref.out\" 2>\"$d/ref.err\" || r=$?\n  n=0; \"$d/main\" > \"$d/native.out\" 2>\"$d/native.err\" || n=$?\n  [[ $n == \"$r\" ]]; cmp \"$d/ref.out\" \"$d/native.out\"\n  if [[ $expected == E_OVERFLOW ]]; then\n     [[ $n == 1 && ! -s \"$d/native.out\" ]]\n     jq -e '.code==\"E_OVERFLOW\"' \"$d/native.err\" >/dev/null; jq -e '.code==\"E_OVERFLOW\"' \"$d/ref.err\" >/dev/null\n  else\n     [[ $n == 0 && ! -s \"$d/native.err\" && ! -s \"$d/ref.err\" ]]\n     if [[ $(cat \"$d/native.out\") != \"$expected\" ]]; then echo \"Expectation mismatch: $name expected $expected got $(cat \"$d/native.out\")\"; exit 1; fi\n  fi\n  jq -nc --arg name \"$name\" --arg expected \"$expected\" --arg hash \"$(sha256sum \"$d/main\"|cut -d' ' -f1)\" --argjson rc \"$n\" '{name:$name,expected:$expected,exit:$rc,native_matches_reference:true,image_sha256:$hash}' >> \"$w/case-results\"\ndone\n"
  }
