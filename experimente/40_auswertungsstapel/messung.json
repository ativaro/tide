  "cpython_source": "import json\nimport sys\n\ndef counts(readings):\n    if len(readings) > 4096:\n        raise ValueError(\"list limit\")\n    below = 0\n    for reading in readings:\n        if type(reading) is not int or not -(1 << 63) <= reading < 1 << 63:\n            raise ValueError(\"integer required\")\n        below += reading < 0\n    return [below, len(readings) - below]\n\ndef peak_lines(rows):\n    if len(rows) > 4096:\n        raise ValueError(\"list limit\")\n    best = None\n    for row, line in enumerate(rows, 1):\n        digits = line.removeprefix(\"-\")\n        if not (digits.isascii() and digits.isdecimal()):\n            raise ValueError((\"invalid_integer\", row))\n        magnitude = digits.lstrip(\"0\") or \"0\"\n        if len(magnitude) > 19:\n            raise ValueError((\"invalid_integer\", row))\n        number = int(magnitude)\n        if line.startswith(\"-\"):\n            number = -number\n        if not -(1 << 63) <= number < 1 << 63:\n            raise ValueError((\"invalid_integer\", row))\n        if best is None or number > best[0]:\n            best = [number, row]\n    return {\"some\": best} if best is not None else {\"none\": True}\n\ncall, inputs = sys.argv[1:]\nresult = {\"counts\": counts, \"peak_lines\": peak_lines}[call](**json.loads(inputs))\nprint(json.dumps(result, separators=(\",\", \":\")))\n",
