  "bench_source": "import gc\nimport itertools\nimport json\nimport os\nimport platform\nimport statistics\nimport sys\nimport time\nfrom pathlib import Path\n\nroot = Path(sys.argv[1])\nfamily = sys.argv[2]\nrepo = Path.cwd()\nsys.path.insert(0, str(repo))\nfrom tide_lang.workbench import project\nfrom tide_lang.program import compile_source\nfrom tide_lang.runtime import Run\n\ncpu = min(os.sched_getaffinity(0))\nos.sched_setaffinity(0, {cpu})\ncases = json.loads((root / 'control' / family / 'cases.json').read_text())\nbatches = [case['input'] for case in cases]\nexpected = [case['expect'] for case in cases]\narms = {}\nsteps = {}\nfor arm in ('tide-plain', 'tide-lib'):\n    path = root / 'canonical' / f'{family}-{arm}' / 'summary.tide'\n    defs, _ = compile_source(*project(path))\n    body = defs['main'].body\n    run = Run(defs)\n    start_budget = run.remaining\n    assert run.eval(body, {'batches': batches}) == expected\n    steps[arm] = start_budget - run.remaining\n    arms[arm] = lambda defs=defs, body=body: Run(defs).eval(body, {'batches': batches})\nsys.path.insert(0, str(root / 'canonical' / f'{family}-python-native'))\nfrom summary import main\narms['python-native'] = lambda: main(batches)\ngc.disable()\nfor call in arms.values():\n    for _ in range(3):\n        assert call() == expected\n\norders = list(itertools.permutations(arms))\nsamples = []\nfor i in range(18):\n    order = orders[i % len(orders)]\n    measurements = {}\n    for arm in order:\n        call = arms[arm]\n        start = time.perf_counter_ns()\n        for _ in range(8):\n            result = call()\n        elapsed = time.perf_counter_ns() - start\n        assert result == expected\n        measurements[arm] = elapsed\n    samples.append({'order': order, 'elapsed_ns_for_eight_calls': measurements})\nmedians = {a: statistics.median(row['elapsed_ns_for_eight_calls'][a] / 8 for row in samples) for a in arms}\nprint(json.dumps(dict(family=family, cases=len(cases), python=platform.python_version(), machine=platform.machine(),\n                      cpu=cpu, steps=steps, samples=samples, warmup=3, repeats=8, median_ns_per_call=medians), indent=2))\n",
