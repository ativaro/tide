use measurements@1.3.0

record Summary
above:i peak:?i

main input:r bytes:i limit:i > {Summary}
fold_lines input bytes (make Summary above 0 peak (nil i)) result row line
let value measurements.parse line row
make Summary
above (if (> value limit) (+ (get above result) 1) (get above result))
peak (some (case (get peak result) value old (if (> value old) value old)))

example exact main
{"inputs":{"input":"80\r\n81\n98","limit":80,"bytes":9},"expect":{"above":2,"peak":{"some":98}}}

example empty main
{"inputs":{"input":"","limit":80,"bytes":0},"expect":{"above":0,"peak":{"none":true}}}

example one_short main
{"inputs":{"input":"80\r\n81\n98","limit":80,"bytes":8},"expect_error":{"code":"E_LIMIT","input_line":3}}

example invalid main
{"inputs":{"input":"80\nx\n","limit":80,"bytes":5},"expect_error":{"code":"E_DATA","reason":"invalid_integer","input_line":2}}

example trailing_cr main
{"inputs":{"input":"12\r","limit":80,"bytes":3},"expect_error":{"code":"E_DATA","reason":"invalid_integer","input_line":1}}

example negative_budget main
{"inputs":{"input":"","limit":0,"bytes":-1},"expect_error":{"code":"E_LIMIT","input_line":1}}
