use rowtext@2.0.0

use measurements@1.3.0

record Summary
above:i peak:?i

main input:r limit:i > {Summary}
summarize (rowtext.parse (read input)) limit

summarize rows:*t limit:i > {Summary}
fold rows (make Summary above 0 peak (nil i)) result row line
let value measurements.parse line row
make Summary
above (if (> value limit) (+ (get above result) 1) (get above result))
peak (some (case (get peak result) value old (if (> value old) value old)))

example threshold main
{"inputs":{"input":"80\r\n81\n98\n","limit":80},"expect":{"above":2,"peak":{"some":98}}}

example empty main
{"inputs":{"input":"","limit":80},"expect":{"above":0,"peak":{"none":true}}}

example invalid main
{"inputs":{"input":"80\nx\n","limit":80},"expect_error":{"code":"E_DATA","reason":"invalid_integer","input_line":2}}

example signed_limits main
{"inputs":{"input":"-9223372036854775808\n9223372036854775807","limit":0},"expect":{"above":1,"peak":{"some":9223372036854775807}}}
