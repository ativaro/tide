let rows list t 54
  "#ifdef TIDE_SERVICE"
  "#include <atomic>"
  "std::atomic_bool tide_stop{false};inline bool tide_service_cancelled(){return tide_stop.load(std::memory_order_relaxed);}"
  "#else"
  "inline bool tide_service_cancelled(){return false;}"
  "#endif"
  "#include <curl/curl.h>"
  "#include <dlfcn.h>"
  "struct CurlApi {"
  "    void* lib=dlopen(\"libcurl.so.4\",RTLD_NOW|RTLD_LOCAL);"
  "    template<class T> T sym(const char* name){return lib?reinterpret_cast<T>(dlsym(lib,name)):nullptr;}"
  "    decltype(&curl_easy_init) init=sym<decltype(init)>(\"curl_easy_init\");"
  "    decltype(&curl_easy_cleanup) cleanup=sym<decltype(cleanup)>(\"curl_easy_cleanup\");"
  "    decltype(&curl_easy_setopt) set=sym<decltype(set)>(\"curl_easy_setopt\");"
  "    decltype(&curl_easy_perform) perform=sym<decltype(perform)>(\"curl_easy_perform\");"
  "    decltype(&curl_easy_getinfo) info=sym<decltype(info)>(\"curl_easy_getinfo\");"
  "    decltype(&curl_slist_append) append=sym<decltype(append)>(\"curl_slist_append\");"
  "    decltype(&curl_slist_free_all) free_list=sym<decltype(free_list)>(\"curl_slist_free_all\");"
  "};"
  "struct HttpBuffer {size_t limit;Text bytes;bool overflow=false;};"
  "size_t http_receive(char* p,size_t size,size_t count,void* state){"
  "    auto& buf=*static_cast<HttpBuffer*>(state);size_t n=size*count;"
  "    if(n>buf.limit-buf.bytes.size()){buf.overflow=true;return 0;}"
  "    for(size_t i=0;i<n;++i)buf.bytes+=static_cast<unsigned char>(p[i]);"
  "    return n;"
  "}"
  "using HttpRaw=std::pair<I,std::pair<Text,Text>>;"
  "HttpRaw t_bootstrap_https(const Text& url,const Seq<Text>& headers,I timeout,I limit,const Opt<Text>& upload){"
  "    static const CurlApi api;"
  "    if(!api.init||!api.cleanup||!api.set||!api.perform||!api.info||!api.append||!api.free_list)return {-4,{}};"
  "    std::unique_ptr<CURL,decltype(api.cleanup)> h(api.init(),api.cleanup);"
  "    if(!h)return {-4,{}};"
  "    curl_slist* raw=nullptr;"
  "    for(const auto& header:headers){auto next=api.append(raw,encode(header).c_str());if(!next){api.free_list(raw);return {-4,{}};}raw=next;}"
  "    std::unique_ptr<curl_slist,decltype(api.free_list)> owned(raw,api.free_list);"
  "    HttpBuffer body{size_t(limit),{}},head{32768,{}};"
  "    auto set=[&](CURLoption k,auto v){return api.set(h.get(),k,v)==CURLE_OK;};"
  "    auto address=encode(url);"
  "    auto progress=+[](void*,curl_off_t,curl_off_t,curl_off_t,curl_off_t){return int(tide_service_cancelled());};"
  "    if(!set(CURLOPT_NOPROGRESS,0L)||!set(CURLOPT_XFERINFOFUNCTION,progress)||"
  "       !set(CURLOPT_URL,address.c_str())||!set(CURLOPT_PROTOCOLS_STR,\"https\")||!set(CURLOPT_PROXY,\"\")||"
  "       !set(CURLOPT_FOLLOWLOCATION,0L)||!set(CURLOPT_SSL_VERIFYPEER,1L)||!set(CURLOPT_SSL_VERIFYHOST,2L)||"
  "       !set(CURLOPT_NOSIGNAL,1L)||!set(CURLOPT_TIMEOUT_MS,long(timeout))||!set(CURLOPT_HTTPHEADER,raw)||"
  "       !set(CURLOPT_WRITEFUNCTION,&http_receive)||!set(CURLOPT_WRITEDATA,&body)||"
  "       !set(CURLOPT_HEADERFUNCTION,&http_receive)||!set(CURLOPT_HEADERDATA,&head))return {-4,{}};"
  "    if(const char* ca=std::getenv(\"TIDE_HTTPS_CA_FILE\");ca&&*ca&&!set(CURLOPT_CAINFO,ca))return {-4,{}};"
  "    std::string payload;"
  "    if(upload){payload.assign(upload->begin(),upload->end());if(!set(CURLOPT_POST,1L)||!set(CURLOPT_POSTFIELDSIZE,long(payload.size()))||!set(CURLOPT_POSTFIELDS,payload.c_str()))return {-4,{}};}"
  "    auto rc=api.perform(h.get());"
  "    if(body.overflow||head.overflow)return {-2,{}};"
  "    if(rc!=CURLE_OK)return {rc==CURLE_OPERATION_TIMEDOUT?-3:rc==CURLE_PEER_FAILED_VERIFICATION?-5:-1,{}};"
  "    long status=0;if(api.info(h.get(),CURLINFO_RESPONSE_CODE,&status)!=CURLE_OK)return {-1,{}};"
  "    return {I(status),{std::move(head.bytes),std::move(body.bytes)}};"
  "}"
fold rows "" code row line concat code (concat line "\n")
