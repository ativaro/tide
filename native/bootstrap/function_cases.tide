use scalar_json

case_record name:t source:t > t
cat3 "{\"name\":" (json_string name) (cat3 ",\"source\":" (json_string source) "}\n")

body_case name:t body:t > t
case_record name (concat "main > i\n" body)

generate_function_cases > t
let ints list t 7 "-9223372036854775808" "-3" "-1" "0" "1" "3" "9223372036854775807"
let arithmetic fold (list t 5 "+" "-" "*" "div" "mod") "" groups group op
  fold ints groups left left_row a
    fold ints left acc right_row b
      let name cat3 (decimal group) (decimal left_row) (decimal right_row)
      concat acc (body_case name (cat3 op " " (cat3 a " " b)))
let bodies list t 24
  "true" "+ 1 false" "(+ 1)" "(+ 1 2 3)" "1 2" "(1)" "((" "not 3" "if 1 2 3"
  "if true 1 false" "if true 1" "(+ 1 2" "+ 9223372036854775808 0" "absent" "((+ 1 2))"
  "let x 1 (+ x x)" "let x 1 (let x 2 x)" "let x (let x 1 x) (+ x 1)" "let 1 2 3"
  "+ true absent" "+ absent true" "if false (div 1 0) 8" "if true 4 (div 1 0)" "let x (div 1 0) 5"
let syntax_cases fold bodies "" acc row body concat acc (body_case (concat "expression" (decimal row)) body)
let sources list t 15
  "main > i\ninc 2\n\ninc value:i > i\n+ value 1"
  "main > i\nnext\n\nnext > i\nmain"
  "main > i\nmain"
  "main > i\nlet next 2 next\n\nnext > i\n0"
  "main > i\n+ (pick true 2 8) (pick false 4 1)\n\npick b:b x:i y:i > i\nif b x y"
  "main > b\nand false (eq (div 1 0) 0)"
  "main > b\nor true (eq (div 1 0) 0)"
  "main > i\nchoose false 1 (div 1 0)\n\nchoose flag:b a:i b:i > i\nif flag a b"
  "main > i\nf 1\n\nf x:i > b\ntrue"
  "main > i\nf false\n\nf x:i > i\nx"
  "main > i\n007\n\nexample mismatch main\n{\"inputs\":{},\"expect\":6}"
  "main > i\ndiv 4 0\n\nexample mismatch main\n{\"expect\":1,\"inputs\":{}}"
  "main > i\n2\n\nexample mismatch main\n{\"inputs\":{},\"expect_error\":{\"code\":\"E_DATA\"}}"
  "main > i\n2\n\nexample ok main\n{\"inputs\":{},\"expect\":2}"
  "use helper\n\nmain > b\npositive (addtwo -1)"
let files fold sources "" acc row source concat acc (case_record (concat "project" (decimal row)) source)
cat3 arithmetic syntax_cases files

double_chain top:i varied:b unique:b > t
fold (indices (+ top 1)) "" acc pos unused
  let level - pos 1
  let name concat "f" (decimal level)
  let prev concat "f" (decimal (if (eq level 0) 0 (- level 1)))
  let sig if varied " x:i > i\n" " > i\n"
  let body if (eq level 0) (if varied "if (> x 0) 1 0" "0")
    (if unique (cat3 "+ (" prev (cat3 " (* x 2)) (" prev " (+ (* x 2) 1))"))
     (if varied (cat3 "+ (" prev (cat3 " (+ x 1)) (" prev " (- x 1))")) (cat3 "+ " prev (concat " " prev))))
  cat3 acc "\n\n" (cat3 name sig body)

exact_budget work:i > t
let costs list i 15 65534 32766 16382 8190 4094 2046 1022 510 254 126 62 30 14 6 2
let built fold costs (pair work "") before row cost
  fold (indices 3) before acc pass unused
    let left first acc
    let name concat "f" (decimal (- 15 row))
    if (eq left cost) (pair 0 (concat (second acc) name))
    (if (> left (+ cost 1)) (pair (- left (+ cost 1)) (cat3 (second acc) "+ " (concat name " "))) acc)
let tail if (eq (first built) 0) "" (if (eq (first built) 1) "0" (if (eq (first built) 3) "+ 0 0" (fail "budget_expression")))
cat3 "main > i\n" (concat (second built) tail) (double_chain 14 false false)

work_cases > t
let exact fold (list i 4 99999 100000 100001 100002) "" acc row n
  concat acc (case_record (concat "budget" (decimal n)) (exact_budget n))
let ceiling case_record "step_limit" (concat "main > i\nf16" (double_chain 16 false false))
let ties case_record "many_ties" (concat "main > i\nf14 0" (double_chain 14 true false))
let distinct case_record "unique" (concat "main > i\nf13 0" (double_chain 13 true true))
cat3 exact ceiling (concat ties distinct)
