let project project_begin source "" (text_len source) "pairs.tide" "!pairs.tide"
let program get program (compile_project project (schema_blocks source true))
let rows list_value (fold (indices 4096) (list i 0) acc row unused append acc row)
let label text_value (fold (indices 58) "" s row unused concat s "Ω")
fold (list i 2 0 1) true ok pos extra
  let result scalar_eval program 0 (list {EvalValue} 3 rows label (number_value extra))
  and ok (if (eq extra 0) (and (text_eq (get code result) "") (eq (get num (get value result)) 4096))
    (and (text_eq (get code result) "E_LIMIT") (case (text_find (get detail result) "Guest allocation budget exhausted" 0) false found true)))

record_pair_allocation_boundary > b
let source "record Cell\nlabel:t\n\nmain rows:*i cell:{Cell} extra:b > i\nlet n fold rows 0 total row x (let entry (pair cell cell) (+ total 1))\nif extra (let entry (pair cell cell) n) n"
let project project_begin source "" (text_len source) "cells.tide" "!cells.tide"
let program get program (compile_project project (schema_blocks source true))
let label text_value (fold (indices 119) "" s row unused concat s "Ω")
let cell add_member (number_value 16) "label" "t" label (field_bytes label "t")
let rows list_value (fold (indices 4096) (list i 0) items row unused append items row)
fold (list i 2 0 1) true ok row extra
  let result scalar_eval program 0 (list {EvalValue} 3 rows cell (number_value extra))
  and ok (if (eq extra 0) (and (text_eq (get code result) "") (eq (get num (get value result)) 4096))
    (and (text_eq (get code result) "E_LIMIT") (case (text_find (get detail result) "Guest allocation budget exhausted" 0) false found true)))

map_boundaries > b
let source "main xs:*i > *i\nmap i xs v (+ v 1)"
let project project_begin source "" (text_len source) "maps.tide" "!maps.tide"
let program get program (compile_project project (schema_blocks source true))
let args list {EvalValue} 1 (list_value (list i 2 1 2))
let start begin_call program 0 args (nil {TraceRequest})
fold (list &ii 3 (pair 8 40) (pair 7 40) (pair 8 39)) true ok row limit
  let initial with remaining (with memory start (second limit)) (first limit)
  let final fold (indices 24) initial machine step unused eval_step machine program false
  let answer get answer final
  and ok (if (eq row 1)
    (and (eq (get memory final) 0) (and (eq (get remaining final) 0) (and (text_eq (get code answer) "") (eq (need (at (get items (get value answer)) 1) "map_last" 0) 3))))
    (and (text_eq (get code answer) "E_LIMIT") (case (text_find (get detail answer) "\"map_index\":1" 0) false found true)))

projected_map_boundaries > b
let source "main xs:*&ii > *i\nmap i xs item (second item)"
let project project_begin source "" (text_len source) "project.tide" "!project.tide"
let program get program (compile_project project (schema_blocks source true))
let input pair_value (number_value -1) (number_value 7) "&ii"
let seq fold (indices 2) (number_value 8) items row skip add_member items "" "&ii" input (pair_bytes input)
let start begin_call program 0 (list {EvalValue} 1 seq) (nil {TraceRequest})
fold (list &ii 3 (pair 6 40) (pair 5 40) (pair 6 39)) true ok row limit
  let base with remaining (with memory start (second limit)) (first limit)
  let fast fold (indices 16) base m index skip eval_step m program false
  let traced fold (indices 16) base m index skip eval_step m program true
  let result get answer fast
  and ok (and (eq (get remaining fast) (get remaining traced)) (and (eq (get memory fast) (get memory traced))
    (and (text_eq (get detail result) (get detail (get answer traced))) (if (eq row 1)
      (and (eq (get remaining fast) 0) (and (eq (get memory fast) 0) (eq (need (at (get items (get value result)) 1) "last" 0) 7)))
      (and (text_eq (get code result) "E_LIMIT") (case (text_find (get detail result) "\"map_index\":1" 0) false found true))))))

projection_work_boundary > b
let source "main v:&ii > i\n+ (first v) (second v)"
let project project_begin source "" (text_len source) "pairs.tide" "!pairs.tide"
let program get program (compile_project project (schema_blocks source true))
let tree need (at (get trees program) 0) "function" 0
let root node_at (get nodes tree) (last_node tree)
let env list {EvalValue} 1 (pair_value (number_value 2) (number_value 5) "&ii")
fold (list i 5 4 10 14 21 0) true ok pos column
  let initial make LeafRun values (list {EvalValue} 0) left (- pos 1) stopped false error (scalar_ok 0)
  let parsed immediate_operands "+" (get children root) env tree "pairs.tide" initial
  let error get error parsed
  and ok (if (eq column 0) (and (text_eq (get code error) "") (and (eq (get left parsed) 0) (eq (length (get values parsed)) 2)))
    (and (text_eq (get code error) "E_LIMIT") (case (text_find (get detail error) (cat3 "\"column\":" (decimal column) "}") 0) false found true)))

text_boundaries > b
let source "rows value:t > *t\nlines value\n\njoin entries:*i part:t > t\nfold entries \"\" a row x (concat a part)"
let project project_begin source "" (text_len source) "text.tide" "?text.tide"
let program get program (compile_project project (schema_blocks source true))
let breaks fold (indices 4096) "" acc row unused concat acc "\n"
let exact scalar_eval program 0 (list {EvalValue} 1 (text_value breaks))
let beyond scalar_eval program 0 (list {EvalValue} 1 (text_value (concat breaks "x")))
if (not (and (text_eq (get code exact) "") (eq (length (get texts (get value exact))) 4096))) fail "line_count_at_limit"
if (not (text_eq (get code beyond) "E_LIMIT")) fail "line_count_above_limit"
let part fold (indices 100) "" acc row unused concat acc "🐈"
fold (list i 2 144 145) true ok row size
  let items fold (indices size) (list i 0) acc pos unused append acc 0
  let result scalar_eval program 1 (list {EvalValue} 2 (list_value items) (text_value part))
  and ok (if (eq size 144) (and (text_eq (get code result) "") (eq (text_len (get text (get value result))) 14400))
    (text_eq (get code result) "E_LIMIT"))

work_limit_examples > b
fold (list i 2 100000 100001) true ok row steps
  let expected if (eq row 1) "\"expect\":0" "\"expect_error\":{\"code\":\"E_LIMIT\"}"
  let source concat (exact_budget steps) (cat3 "\n\nexample boundary main\n{\"inputs\":{}," expected "}")
  let project project_begin source "" (text_len source) "budget.tide" "?budget.tide"
  and ok (text_eq (project_finish project "?budget.tide" "" "{}") "{\"passed\":1}\n")

list_budget_examples > b
let head "main xs:*i > i\nfold xs 0 a r x (length (grow xs))\n\ngrow xs:*i > *i\nappend xs 1\n"
fold (list i 2 511 512) true ok row size
  let items fold (indices size) "" xs pos unused json_item xs "0"
  let expected if (eq size 511) "\"expect\":512" "\"expect_error\":{\"code\":\"E_LIMIT\"}"
  let source concat head (cat3 "\nexample memory main\n{\"inputs\":{\"xs\":[" items (cat3 "]}," expected "}"))
  let project project_begin source "" (text_len source) "memory.tide" "?memory.tide"
  and ok (text_eq (project_finish project "?memory.tide" "" "{}") "{\"passed\":1}\n")

full_list_literal > b
let items fold (indices 4096) "" acc pos unused concat acc (if (eq (mod pos 256) 0) "\n0 " "0 ")
let source cat3 "main > i\nlength (list i 4096 " items ")\n"
let project project_begin source "" (text_len source) "literal.tide" "!literal.tide"
text_eq (project_finish project "!literal.tide" "main" "{}") "4096\n"

fold_work_boundary > b
let outer_values fold (indices 52) "" acc pos unused json_item acc "1"
let inner_values fold (indices 640) "" acc pos unused json_item acc "1"
let inputs cat3 "{\"outer_values\":[" outer_values (cat3 "],\"inner_values\":[" inner_values "]}")
fold (list t 2 "not " "not not ") true ok row prefix
  let expr concat prefix "fold outer_values false a r x (fold inner_values a b q y (eq y x))"
  let expected if (eq row 1) "\"expect\":false" "\"expect_error\":{\"code\":\"E_LIMIT\"}"
  let source concat "main outer_values:*i inner_values:*i > b\n" (cat3 expr "\n\nexample boundary main\n" (cat3 "{\"inputs\":" inputs (cat3 "," expected "}")))
  let project project_begin source "" (text_len source) "boundary.tide" "?boundary.tide"
  and ok (text_eq (project_finish project "?boundary.tide" "" "{}") "{\"passed\":1}\n")

rule_trace_boundary > b
let source "rule counter x:i > i\nstate n:i=1\nwhen eq x 0 -> n=reset\nelse -> n=set (div n x)\nout n\n\nexample three counter\n{\"events\":[1,0,-1],\"expect\":[1,1,-1]}"
let request project_begin source "" (text_len source) "trace.tide" "^trace.tide"
let got project_finish request "^trace.tide" "three" "2|n,n"
text_eq got "{\"rule\":\"counter\",\"step\":2,\"event\":0,\"branch\":1,\"fields\":{\"n\":{\"before\":1,\"action\":\"reset\",\"after\":1}},\"output\":1,\"example\":\"three\"}\n"

scan_work_boundary > b
let body fold (indices 12) "n" expr pos unused concat "+ 0 " expr
let source cat3 "rule stable x:b > i\nstate n:i=0\nwhen x -> n=keep\nelse -> n=set " body "\nout n\n\nmain xs:*b > *i\nscan stable xs"
let project project_begin source "" (text_len source) "budget.tide" "!budget.tide"
let program get program (compile_project project (schema_blocks source true))
fold (list i 2 3445 3446) true ok row costly
  let cheap if (eq row 1) 23 16
  let n + costly cheap
  let xs fold (indices n) (list i 0) acc pos unused append acc (if (> pos costly) 1 0)
  let result scalar_eval program 1 (list {EvalValue} 1 (list_value xs))
  and ok (if (eq row 1) (and (text_eq (get code result) "") (eq (length (get items (get value result))) n))
    (and (text_eq (get code result) "E_LIMIT") (case (text_find (get detail result) (cat3 "\"event\":" (decimal n) "}") 0) false hit true)))

json_batch_boundary > b
let prefix fold (indices 64) "" acc pos unused json_item acc "-1"
let mixed read_flat_array (cat3 "[" prefix ", true, 7]")
if (not (and (text_eq (get typ mixed) "invalid") (eq (length (get items mixed)) 64))) fail "mixed_array_prefix"
let nums read_flat_array (cat3 "[ " prefix " ,\t-0\r\n]")
and (text_eq (get compact nums) (json_item prefix "0"))
  (and (eq (get count nums) 65) (eq (need (at (get items nums) 64) "last" 0) 0))

suite_fixture leaf:t source:t > {ProjectFiles}
let start project_begin source "" (text_len source) "suite.tide" "?suite.tide"
project_supply start leaf "" (text_len leaf)

suite_reuse_checks > b
let root "use fee\n\ncharge qty:i > i\nrate qty\n\nindependent > i\n3\n\nexample order charge\n{\"inputs\":{\"qty\":2},\"expect\":4}\n\nexample other independent\n{\"inputs\":{},\"expect\":3}"
let original suite_fixture "rate qty:i > i\n* qty 2" root
let initial suite_step original "suite.tide" (nil {SuiteState})
let changed suite_fixture "rate qty:i > i\n+ qty qty" root
let next suite_step changed "suite.tide" (some initial)
let again suite_step changed "suite.tide" (some next)
let broken suite_fixture "rate qty:b > i\nif qty 1 0" root
let body_error suite_fixture "rate qty:i > i\n+ qty 1" root
let stale_type bootstrap_recover (< (get checked (suite_step broken "suite.tide" (some initial))) 0) true
let stale_value bootstrap_recover (< (get checked (suite_step body_error "suite.tide" (some initial))) 0) true
and (and stale_type stale_value) (and (and (eq (get checked initial) 3) (eq (get executed initial) 2))
  (and (and (eq (get checked next) 1) (eq (get executed next) 1))
       (and (eq (get checked again) 0) (eq (get executed again) 0))))

suite_layout_checks > b
let source "use fee\n\ncharge qty:i > i\nget value (rate qty)\n\nexample order charge\n{\"inputs\":{\"qty\":2},\"expect\":2}"
let leaf "record Amount\nvalue:i\n\nrate qty:i > {Amount}\nmake Amount value qty"
let prior suite_step (suite_fixture leaf source) "suite.tide" (nil {SuiteState})
let schema suite_fixture "record Amount\nvalue:t\n\nrate qty:i > {Amount}\nmake Amount value \"two\"" source
let bad_contract suite_fixture leaf (concat source "\n\nexample wrong charge\n{\"inputs\":{\"qty\":2},\"expect\":3}")
let reordered suite_fixture leaf (concat source "\n\nnew_fn qty:i > i\nqty")
let full suite_step reordered "suite.tide" (some prior)
and (and (eq (get checked full) 3) (eq (get executed full) 1))
  (and (bootstrap_recover (< (get checked (suite_step schema "suite.tide" (some prior))) 0) true)
       (bootstrap_recover (< (get executed (suite_step bad_contract "suite.tide" (some prior))) 0) true))
