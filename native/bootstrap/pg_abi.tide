pg_abi > t
let rows list t 77
  "#include <poll.h>"
  "#include <dlfcn.h>"
  "#if __has_include(<libpq-fe.h>)"
  "#include <libpq-fe.h>"
  "#else"
  "#include <postgresql/libpq-fe.h>"
  "#endif"
  "struct PgApi {"
  "    void* lib=dlopen(\"libpq.so.5\",RTLD_NOW|RTLD_LOCAL);"
  "    template<class T>T sym(const char* key){return lib?reinterpret_cast<T>(dlsym(lib,key)):nullptr;}"
  "    decltype(&PQconnectdbParams) connectdbParams=sym<decltype(connectdbParams)>(\"PQconnectdbParams\");"
  "    decltype(&PQstatus) status=sym<decltype(status)>(\"PQstatus\");"
  "    decltype(&PQfinish) finish=sym<decltype(finish)>(\"PQfinish\");"
  "    decltype(&PQsendQueryParams) sendQueryParams=sym<decltype(sendQueryParams)>(\"PQsendQueryParams\");"
  "    decltype(&PQsetSingleRowMode) setSingleRowMode=sym<decltype(setSingleRowMode)>(\"PQsetSingleRowMode\");"
  "    decltype(&PQgetResult) getResult=sym<decltype(getResult)>(\"PQgetResult\");"
  "    decltype(&PQresultStatus) resultStatus=sym<decltype(resultStatus)>(\"PQresultStatus\");"
  "    decltype(&PQnfields) nfields=sym<decltype(nfields)>(\"PQnfields\");"
  "    decltype(&PQfname) fname=sym<decltype(fname)>(\"PQfname\");"
  "    decltype(&PQftype) ftype=sym<decltype(ftype)>(\"PQftype\");"
  "    decltype(&PQgetisnull) getisnull=sym<decltype(getisnull)>(\"PQgetisnull\");"
  "    decltype(&PQgetvalue) getvalue=sym<decltype(getvalue)>(\"PQgetvalue\");"
  "    decltype(&PQgetlength) getlength=sym<decltype(getlength)>(\"PQgetlength\");"
  "    decltype(&PQclear) clear=sym<decltype(clear)>(\"PQclear\");"
  "    decltype(&PQcmdTuples) cmdTuples=sym<decltype(cmdTuples)>(\"PQcmdTuples\");"
  "    decltype(&PQresultErrorField) resultErrorField=sym<decltype(resultErrorField)>(\"PQresultErrorField\");"
  "    decltype(&PQisBusy) isBusy=sym<decltype(isBusy)>(\"PQisBusy\");"
  "    decltype(&PQconsumeInput) consumeInput=sym<decltype(consumeInput)>(\"PQconsumeInput\");"
  "    decltype(&PQsocket) socket=sym<decltype(socket)>(\"PQsocket\");"
  "    decltype(&PQgetCancel) getCancel=sym<decltype(getCancel)>(\"PQgetCancel\");"
  "    decltype(&PQcancel) cancel=sym<decltype(cancel)>(\"PQcancel\");"
  "    decltype(&PQfreeCancel) freeCancel=sym<decltype(freeCancel)>(\"PQfreeCancel\");"
  "    bool ready()const{return isBusy&&consumeInput&&socket&&getCancel&&cancel&&freeCancel&&connectdbParams&&status&&finish&&sendQueryParams&&setSingleRowMode&&getResult&&resultStatus&&nfields&&fname&&ftype&&getisnull&&getvalue&&getlength&&clear&&cmdTuples&&resultErrorField;}"
  "};"
  "const PgApi& pg_api(){static const PgApi api;return api;}"
  "Opt<R_NativeHandle> t_bootstrap_pg_open(const Text& grant){"
  "    auto& api=pg_api();if(!api.ready())return {};"
  "    const char* keys[]={\"dbname\",\"connect_timeout\",\"client_encoding\",\"options\",nullptr};"
  "    auto dsn=encode(grant);const char* values[]={dsn.c_str(),\"5\",\"UTF8\",\"-c statement_timeout=5000 -c client_encoding=UTF8 -c timezone=UTC -c datestyle=ISO\",nullptr};"
  "    auto db=api.connectdbParams(keys,values,1);R_NativeHandle owned(db,[](void* p){if(p)pg_api().finish(static_cast<PGconn*>(p));});"
  "    if(!db||api.status(db)!=CONNECTION_OK)return {};return owned;"
  "}"
  "struct PgRows{"
  "    R_NativeHandle owner;PGresult* row=nullptr;bool pending=true;"
  "    explicit PgRows(const R_NativeHandle& connection):owner(connection){}"
  "    ~PgRows(){auto& api=pg_api();if(row)api.clear(row);while(pending){auto r=api.getResult(static_cast<PGconn*>(owner.get()));if(!r)break;api.clear(r);}}"
  "};"
  "Opt<R_NativeHandle> t_bootstrap_pg_send(const R_NativeHandle& db,const Text& sql,const Seq<Text>& values,const Seq<I>& nulls){"
  "    auto& api=pg_api();std::vector<std::string> strings;std::vector<const char*> args;"
  "    for(const auto& v:values)strings.push_back(encode(v));for(size_t i=0;i<strings.size();++i)args.push_back(nulls[i]?nullptr:strings[i].c_str());"
  "    auto c=static_cast<PGconn*>(db.get());auto cursor=std::make_shared<PgRows>(db);"
  "    if(!api.sendQueryParams(c,encode(sql).c_str(),int(args.size()),nullptr,args.data(),nullptr,nullptr,0)||!api.setSingleRowMode(c))return {};"
  "    return R_NativeHandle(cursor);"
  "}"
  "PGresult* pg_row(const R_NativeHandle& cursor){return static_cast<PgRows*>(cursor.get())->row;}"
  "I t_bootstrap_pg_step(const R_NativeHandle& h){"
  "    auto& api=pg_api();auto& c=*static_cast<PgRows*>(h.get());if(c.row)api.clear(c.row);"
  "    c.row=nullptr;auto db=static_cast<PGconn*>(c.owner.get());"
  "    while(api.isBusy(db)){"
  "        if(tide_service_cancelled()){"
  "            if(auto cancel=api.getCancel(db)){char error[256];api.cancel(cancel,error,sizeof error);api.freeCancel(cancel);}"
  "            return -1;"
  "        }"
  "        pollfd fd{api.socket(db),POLLIN,0};if(fd.fd<0)return -1;"
  "        int n=poll(&fd,1,50);if(n<0&&errno==EINTR)continue;"
  "        if(n<0||(n>0&&!api.consumeInput(db)))return -1;"
  "    }"
  "    c.row=api.getResult(db);if(!c.row){c.pending=false;return -1;}"
  "    return I(api.resultStatus(c.row));"
  "}"
  "I t_bootstrap_pg_cols(const R_NativeHandle& h){return pg_api().nfields(pg_row(h));}"
  "Text t_bootstrap_pg_name(const R_NativeHandle& h,I col){return decode(pg_api().fname(pg_row(h),int(col)));}"
  "I t_bootstrap_pg_oid(const R_NativeHandle& h,I col){return pg_api().ftype(pg_row(h),int(col));}"
  "I t_bootstrap_pg_size(const R_NativeHandle& h,I col){auto& a=pg_api();auto r=pg_row(h);return a.getisnull(r,0,col)?-1:a.getlength(r,0,col);}"
  "Text t_bootstrap_pg_value(const R_NativeHandle& h,I col){auto& a=pg_api();auto r=pg_row(h);return decode(std::string(a.getvalue(r,0,col),a.getlength(r,0,col)));}"
  "Text t_bootstrap_pg_count(const R_NativeHandle& h){return decode(pg_api().cmdTuples(pg_row(h)));}"
  "Text t_bootstrap_pg_error(const R_NativeHandle& h){auto r=pg_row(h);auto p=r?pg_api().resultErrorField(r,PG_DIAG_SQLSTATE):nullptr;return p?decode(p):Text{};}"
fold rows "" code row line concat code (concat line "\n")
