use functions

check_functions fns:*{Signature} names:*t > {CheckedFunctions}
let trees fold fns (list {FunctionTree} 0) acc row fn
  let valid fold (get params fn) true ok pos key and ok (text_eq key (checked_name key (call_bindings fn names) (get loc fn) (get file fn)))
  if (not valid) fail "function_binding"
  let tree if (rule_signature fn) (rule_tree fn fns names) (typed_body fn fns names empty_tree)
  append acc (with calls tree (sorted_labels (get calls tree)))
let budget fold trees 0 n row tree + n (+ 2 (length (get calls tree)))
let blank make CallWalk root 0 path (list {CallFrame} 0) done (list t 0) summaries (list {FunctionSummary} 0)
let walk fold (indices (div (+ budget 511) 512)) blank before chunk unused
  let left - budget (* (- chunk 1) 512)
  fold (indices (if (> left 512) 512 left)) before acc tick unused_tick advance_calls acc fns names trees
if (not (eq (length (get done walk)) (length names))) fail "unfinished_call_graph"
let summaries fold names (list {FunctionSummary} 0) acc row name
  append acc (need (at (get summaries walk) (need (entry_at (get done walk) name) "missing_definition" 0)) "summary" 0)
make CheckedFunctions names names signatures fns trees trees info summaries


site_count buf:{SiteBuffer} > i
+ (* 256 (length (get pages buf))) (length (get tail buf))

site_at buf:{SiteBuffer} index:i > {Site}
let group case (at (get pages buf) (div index 256)) (get tail buf) earlier earlier
need (at group (mod index 256)) "rule_token" 0

site_span buf:{SiteBuffer} lo:i hi:i > {SiteBuffer}
let n - hi lo
fold (indices (chunk_count n)) empty_sites prior part unused
  let base * (- part 1) 2048
  let left - n base
  fold (indices (if (< left 2048) left 2048)) prior acc pos unused_pos
    site_push acc (site_at buf (+ lo (+ base (- pos 1))))

rule_rows body:{SiteBuffer} > *{SiteBuffer}
let grouped fold (site_pages body) (pair (list {SiteBuffer} 0) empty_sites) prior part page
  fold page prior acc pos site
    let live second acc
    let newline case (at (get tail live) 0) false last (not (eq (get line site) (get line last)))
    if newline (pair (append (first acc) live) (site_push empty_sites site)) (pair (first acc) (site_push live site))
append (first grouped) (second grouped)

rule_expr fn:{Signature} fns:*{Signature} names:*t tree:{FunctionTree} body:{SiteBuffer} typ:t > {FunctionTree}
typed_body (with body (with result fn typ) body) fns names tree

last_node tree:{FunctionTree} > i
- (node_count (get nodes tree)) 1

rule_initials fn:{Signature} fns:*{Signature} names:*t line:{SiteBuffer} > {FunctionTree}
let n - (site_count line) 1
let file get file fn
if (or (eq n 0) (not (eq (mod n 3) 0))) fail (diagnosis file (site_at line 0) "E_SYNTAX" "Expected name:type=start entries")
let closed with params (with types fn (list t 0)) (list t 0)
fold (indices (div n 3)) empty_tree acc row unused
  let pos + (* (- row 1) 3) 1
  let site site_at line pos
  let token get word site
  let invalid diagnosis file site "E_TYPE" "Expected name:type"
  let cut need (text_find token ":" 0) invalid 0
  let typ text_slice token (+ cut 1) (text_len token)
  if (and (not (text_eq typ "r")) (case (data_shape typ) true shape false)) fail invalid
  let plan get plan acc
  let name checked_name (checked_name (checked_name (text_slice token 0 cut) (call_bindings fn names) site file) (get params fn) site file) (get fields plan) site file
  if (not (and (scalar_type typ) (text_eq (get word (site_at line (+ pos 1))) "="))) fail (diagnosis file site "E_TYPE" "Expected scalar state initializer")
  let next rule_expr closed fns names acc (site_push empty_sites (site_at line (+ pos 2))) typ
  with plan next (with starts (with types (with fields plan (append (get fields plan) name)) (append (get types plan) typ)) (append (get starts plan) (last_node next)))

record ActionReader
tree:{FunctionTree} keys:*t values:*i

rule_action fn:{Signature} fns:*{Signature} names:*t reader:{ActionReader} clause:{SiteBuffer} head:{Site} > {ActionReader}
let file get file fn
let n site_count clause
if (or (< n 3) (not (text_eq (get word (site_at clause 1)) "="))) fail (diagnosis file head "E_SYNTAX" "Expected field=action")
let key_site site_at clause 0
let key get word key_site
let tree get tree reader
let plan get plan tree
let invalid diagnosis file key_site "E_NAME" "Unknown or duplicate state field"
let idx need (entry_at (get fields plan) key) invalid 0
if (case (entry_at (get keys reader) key) false dup true) fail invalid
let op site_at clause 2
let mode get word op
let write text_eq mode "set"
let next if write (rule_expr fn fns names tree (site_span clause 3 n) (need (at (get types plan) idx) "field_type" 0)) tree
let value if write (last_node next)
  (if (and (eq n 3) (text_eq mode "keep")) -1 (if (and (eq n 3) (text_eq mode "reset")) -2 (fail (diagnosis file op "E_SYNTAX" "Unknown state action"))))
make ActionReader tree next keys (append (get keys reader) key) values (append (get values reader) value)

rule_branch fn:{Signature} fns:*{Signature} names:*t tree:{FunctionTree} line:{SiteBuffer} > {FunctionTree}
let file get file fn
let head site_at line 0
let n site_count line
let found fold (site_pages line) -1 held part page
  fold page held acc pos site if (and (< acc 0) (text_eq (get word site) "->")) (+ (* (- part 1) 256) (- pos 1)) acc
if (< found 0) fail (diagnosis file head "E_SYNTAX" "Missing ->")
let plan get plan tree
let branches get branches plan
let unreachable case (at branches (- (length branches) 1)) false branch (< (get guard branch) 0)
if (or (eq found 0) unreachable) fail (diagnosis file head "E_SYNTAX" "Invalid or unreachable branch")
let conditional text_eq (get word head) "when"
if (not (or conditional (and (eq found 1) (text_eq (get word head) "else")))) fail (diagnosis file head "E_SYNTAX" "Expected when or else")
let checked if conditional (rule_expr fn fns names tree (site_span line 1 found) "b") tree
let guard if conditional (last_node checked) -1
let terms site_span line (+ found 1) n
let first_action make ActionReader tree checked keys (list t 0) values (list i 0)
let clauses fold (site_pages terms) (pair first_action empty_sites) held part page
  fold page held acc pos site
    if (text_eq (get word site) ",") (pair (rule_action fn fns names (first acc) (second acc) head) empty_sites)
    pair (first acc) (site_push (second acc) site)
let parsed rule_action fn fns names (first clauses) (second clauses) head
if (not (eq (length (get keys parsed)) (length (get fields plan)))) fail (diagnosis file head "E_TYPE" "Branch must assign every field")
let actions fold (get fields plan) (list i 0) acc pos key
  append acc (need (at (get values parsed) (need (entry_at (get keys parsed) key) "field_index" 0)) "field_action" 0)
with plan (get tree parsed) (with branches plan (append branches (make RuleBranch guard guard actions actions)))

rule_tree fn:{Signature} fns:*{Signature} names:*t > {FunctionTree}
let rows rule_rows (get body fn)
let n length rows
let first_line need (at rows 0) "state_line" 0
let last_line need (at rows (- n 1)) "out_line" 0
if (or (< n 3) (not (and (text_eq (get word (site_at first_line 0)) "state") (text_eq (get word (site_at last_line 0)) "out"))))
  fail (diagnosis (get file fn) (get loc fn) "E_SYNTAX" "Expected state, branches and out")
let initial rule_initials fn fns names first_line
let plan get plan initial
let scoped with params (with types fn (fold (get types plan) (get types fn) acc pos kind append acc kind))
  (fold (get fields plan) (get params fn) acc pos key append acc key)
let checked fold rows initial acc pos line
  if (or (eq pos 1) (eq pos n)) acc (rule_branch scoped fns names acc line)
let branches get branches (get plan checked)
if (case (at branches (- (length branches) 1)) true branch (not (< (get guard branch) 0)))
  fail (diagnosis (get file fn) (get loc fn) "E_SYNTAX" "Missing final else")
rule_expr scoped fns names checked (site_span last_line 1 (site_count last_line)) (get result fn)
