scan_expression machine:{EvalMachine} parents:*{EvalFrame} frame:{EvalFrame} scanning:{ScanState} tree:{FunctionTree} fn:{Signature} index:i env:*{EvalValue} observing:b > {EvalMachine}
let node node_at (get nodes tree) index
let op get word (get site node)
let kids get children node
if (or (not (get simple node)) (and observing (lazy_operand op))) (scan_continue machine parents frame scanning (some (eval_frame (get owner frame) index env)))
let left - (get remaining machine) 1
let file get file fn
if (< left 0) (eval_return parents 0 (scalar_failure file (get site node) "E_LIMIT" "Work budget exhausted" "") machine)
let operands if (eq (length kids) 0) (make LeafRun values (list {EvalValue} 0) left left stopped true error (scalar_ok 0))
  (immediate_operands op kids env tree file (make LeafRun values (list {EvalValue} 0) left left stopped false error (scalar_ok 0)))
let err get error operands
if (not (text_eq (get code err) "")) (eval_return parents 0 err machine)
let values get values operands
if (not (< (next_operand op values (length kids)) 0)) (scan_continue machine parents frame scanning (some (eval_frame (get owner frame) index env)))
let result completed_scalar node env values file
let remaining get left operands
if (not (text_eq (get code result) "")) (eval_return parents remaining result machine)
let next with values (with scan_state frame (some scanning)) (list {EvalValue} 1 (get value result))
with stack (with remaining machine remaining) (append parents next)

scan_step machine:{EvalMachine} program:{CheckedFunctions} frame:{EvalFrame} tree:{FunctionTree} scanning:{ScanState} observing:b > {EvalMachine}
let owner get owner frame
let fn need (at (get signatures program) owner) "rule_definition" 0
let plan get plan tree
let phase get phase scanning
let parents eval_parents (get stack machine)
let received at (get values frame) 0
let left get remaining machine
let no_child nil {EvalFrame}
if (text_eq phase "init")
  (let stored get initial scanning
   let initial case received stored v (append stored v)
   let next with initial scanning initial
   case (at (get starts plan) (length initial))
     (scan_continue machine parents frame (with phase (with prior next initial) "event") no_child)
     index (scan_expression machine parents frame next tree fn index (list {EvalValue} 0) observing))
let events get items (need (at (get env frame) 0) "scan_events" 0)
let event get event scanning
if (text_eq phase "event")
  (if (eq event (length events)) (eval_return parents left (value_ok (list_value (get outputs scanning))) machine)
   if (eq left 0)
     (let error scalar_failure (get file fn) (get loc fn) "E_LIMIT" "Work budget exhausted" ""
      eval_return parents 0 (with detail error (extra_fields (get detail error) (concat "\"event\":" (decimal (+ event 1))))) machine)
   let next with event (with branch (with phase scanning "guard") 0) (+ event 1)
   scan_continue (with remaining machine (- left 1)) parents frame next no_child)
let input_value need (at events (- event 1)) "scan_event" 0
let branch_index get branch scanning
if (text_eq phase "guard")
  (let accepted case received false v (not (eq (get num v) 0))
   let index + branch_index (if (and (not accepted) (case received false v true)) 1 0)
   let branch need (at (get branches plan) index) "scan_guard" 0
   let next with branch scanning index
   if (or accepted (< (get guard branch) 0)) (scan_continue machine parents frame (with phase next "actions") no_child)
   scan_expression machine parents frame next tree fn (get guard branch) (scan_scope input_value (get prior scanning)) observing)
if (text_eq phase "actions")
  (let changed get updated scanning
   let updated case received changed v (append changed v)
   let next with updated scanning updated
   let branch need (at (get branches plan) branch_index) "scan_branch" 0
   let pos length updated
   case (at (get actions branch) pos)
     (scan_expression machine parents frame (with phase next "emit") tree fn (last_node tree) (scan_scope input_value updated) observing)
     action
     if (eq left 0) (eval_return parents 0 (scalar_failure (get file fn) (get loc fn) "E_LIMIT" "Work budget exhausted" "") machine)
     let charged with remaining machine (- left 1)
     if (not (< action 0)) (scan_expression charged parents frame next tree fn action (scan_scope input_value (get prior scanning)) observing)
     let source if (eq action -1) (get prior scanning) (get initial scanning)
     scan_continue charged parents frame (with updated next (append updated (need (at source pos) "scan_slot" 0))) no_child)
let value get num (need received "scan_output" 0)
let memory - (get memory machine) 8
if (< memory 0) (eval_return parents left (scalar_failure (get file fn) (get loc fn) "E_LIMIT" "Guest allocation budget exhausted" "") machine)
let capture case (get request scanning) false query (eq (get step query) event)
if capture
  (let query need (get request scanning) "trace_request" 0
   let info trace_record fn plan scanning query input_value value
   eval_return parents left (with trace (scalar_ok value) info) (with memory machine memory))
let next with outputs (with prior (with updated (with phase scanning "event") (list {EvalValue} 0)) (get updated scanning)) (append (get outputs scanning) value)
scan_continue (with memory machine memory) parents frame next no_child

trace_record fn:{Signature} plan:{RulePlan} scanning:{ScanState} query:{TraceRequest} input_value:i output_value:i > t
let branch need (at (get branches plan) (get branch scanning)) "trace_branch" 0
let fields fold (get fields query) "" body row key
  let pos need (entry_at (get fields plan) key) "trace_field" 0
  let kind need (at (get types plan) pos) "trace_type" 0
  let mode need (at (get actions branch) pos) "trace_action" 0
  let before wire_number (get num (need (at (get prior scanning) pos) "trace_before" 0)) kind
  let after wire_number (get num (need (at (get updated scanning) pos) "trace_after" 0)) kind
  let action if (eq mode -1) "keep" (if (eq mode -2) "reset" "set")
  json_item body (cat3 (json_string key) ":{\"before\":" (cat3 before ",\"action\":" (cat3 (json_string action) ",\"after\":" (concat after "}"))))
let prefix cat3 "{\"rule\":" (json_string (get name fn)) (cat3 ",\"step\":" (decimal (get event scanning)) ",\"event\":")
let payload wire_number input_value (need (at (get types fn) 0) "event_type" 0)
cat3 prefix payload (cat3 ",\"branch\":" (decimal (+ (get branch scanning) 1))
  (cat3 ",\"fields\":{" fields (cat3 "},\"output\":" (wire_number output_value (get result fn)) "}")))

passed_examples compiled:{CompiledProject} file:t > i
let samples get samples compiled
fold (get examples (get declarations compiled)) 0 passed row ex
  let mismatch example_mismatch ex (need (at samples (- row 1)) "sample" 0) (get program compiled) file
  if (text_eq mismatch "") (+ passed 1) (fail mismatch)
