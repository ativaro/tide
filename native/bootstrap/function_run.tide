text_operation op:t > b
if (or (text_eq op "int") (text_eq op "lines")) true
if (or (text_eq op "text_find") (text_eq op "text_rfind")) true
or (or (text_eq op "text_len") (text_eq op "text_eq")) (or (text_eq op "text_slice") (text_eq op "concat"))

eval_text node:{FunctionNode} file:t values:*{EvalValue} machine:{EvalMachine} parents:*{EvalFrame} left:i > {EvalMachine}
