let op get word site
let a get text (need (at values 0) "text_argument" 0)
let n text_len a
if (or (text_eq op "lines") (text_eq op "int"))
  (let remaining - left (+ 1 (div n 32))
   if (< remaining 0) (eval_return parents 0 (scalar_failure file site "E_LIMIT" "Work budget exhausted" "") machine)
   if (text_eq op "int") (eval_return parents remaining (value_ok (case (int a) (number_value 0) result (with present (number_value result) true))) machine)
   if (not (line_count_ok a)) (eval_return parents remaining (scalar_failure file site "E_LIMIT" "Line count limit" "") machine)
   return_strings (lines a) machine parents remaining file site)
if (text_eq op "text_len") (eval_return parents left (scalar_ok n) machine)
let arg need (at values 1) "text_argument" 0
let b get text arg
if (or (text_eq op "text_find") (text_eq op "text_rfind"))
  (let bound clamp_offset (get num (need (at values 2) "search_bound" 0)) n
   let remaining - left (+ 1 (div (+ n (text_len b)) 32))
   if (< remaining 0) (eval_return parents 0 (scalar_failure file site "E_LIMIT" "Work budget exhausted" "") machine)
   let pos if (text_eq op "text_find") (text_find a b bound) (text_rfind a b bound)
   let result case pos (number_value 0) offset (with present (number_value offset) true)
   eval_return parents remaining (value_ok result) machine)
if (text_eq op "text_eq")
  (let shortest if (< n (text_len b)) n (text_len b)
   let remaining - left (+ 1 (div shortest 32))
   if (< remaining 0) (eval_return parents 0 (scalar_failure file site "E_LIMIT" "Work budget exhausted" "") machine)
   eval_return parents remaining (scalar_ok (if (text_eq a b) 1 0)) machine)
let balance get memory machine
let slicing text_eq op "text_slice"
let lo if slicing (clamp_offset (get num arg) n) 0
let hi if slicing (clamp_offset (get num (need (at values 2) "text_stop" 0)) n) 0
let size if slicing (if (> hi lo) (- hi lo) 0) (+ n (text_len b))
let bytes * 4 size
if (and (not slicing) (> bytes balance)) (eval_return parents left (scalar_failure file site "E_LIMIT" "Text budget exhausted" "") machine)
let available - balance (+ 8 bytes)
if (< available 0) (eval_return parents left (scalar_failure file site "E_LIMIT" "Guest allocation budget exhausted" "") machine)
let value if slicing (text_slice a lo hi) (concat a b)
eval_return parents left (value_ok (text_value value)) (with memory machine available)

clamp_offset pos:i size:i > i
if (< pos 0) 0 (if (> pos size) size pos)

