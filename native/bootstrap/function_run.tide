use https

use sqlite

use value_diff

use run_inputs

record TraceRequest
step:i fields:*t

record ScanState
phase:t event:i branch:i initial:*{EvalValue} prior:*{EvalValue} updated:*{EvalValue} outputs:*i request:?{TraceRequest}

start_scan > {ScanState}
make ScanState phase "init" event 0 branch 0 initial (list {EvalValue} 0) prior (list {EvalValue} 0) updated (list {EvalValue} 0) outputs (list i 0) request (nil {TraceRequest})

record EvalFrame
owner:i node:i env:*{EvalValue} values:*{EvalValue} entered:b started:i cursor:i stream_pos:i trap:i map_index:i scan_state:?{ScanState} transaction_db:?{NativeHandle}

record CallCache
target:i args:*{EvalValue} value:{EvalValue} work:i misses:i

record EvalMachine
stack:*{EvalFrame} remaining:i answer:{ScalarResult} cache:*{CallCache} memory:i reads:*{ReadSnapshot} read_left:i stream_left:i

eval_frame owner:i node:i env:*{EvalValue} > {EvalFrame}
make EvalFrame owner owner node node env env values (list {EvalValue} 0) entered false started -1 cursor 0 stream_pos 0 trap 0 map_index -1 scan_state (nil {ScanState}) transaction_db (nil {NativeHandle})

eval_root program:{CheckedFunctions} index:i env:*{EvalValue} > {EvalFrame}
let tree need (at (get trees program) index) "function_tree" 0
let frame eval_frame index (- (node_count (get nodes tree)) 1) env
if (> (length (get starts (get plan tree))) 0) (with scan_state frame (some start_scan)) frame

eval_parents stack:*{EvalFrame} > *{EvalFrame}
fold stack (list {EvalFrame} 0) acc row frame
  if (eq row (length stack)) acc (append acc frame)

unwind_error parents:*{EvalFrame} left:i result:{ScalarResult} machine:{EvalMachine} > {EvalMachine}
let bit error_bit (get code result)
let handler if (eq bit 0) 0 (fold parents 0 index row frame if (eq (get trap frame) bit) row index)
let closed fold parents 0 rc pos unused
  let row + 1 (- (length parents) pos)
  if (not (> row handler)) rc
  let exited need (at parents (- row 1)) "unwind_frame" 0
  case (get transaction_db exited) rc db
  let rolled sql_rollback db
  if (eq rc 0) rolled rc
if (not (eq closed 0))
  (with stack (with answer machine (scalar_failure "" (make Site word "transaction" line 1 column 1) "E_TRANSACTION" "SQLite rollback failed" "")) (list {EvalFrame} 0))
let event fold (get stack machine) 0 idx row ancestor
  if (not (> row handler)) idx
  case (get scan_state ancestor) idx scanning if (or (text_eq (get phase scanning) "init") (text_eq (get phase scanning) "event")) idx (get event scanning)
let detail get detail result
let reported if (and (> event 0) (case (text_find detail ",\"event\":" 0) true found false)) (with detail result (extra_fields detail (concat "\"event\":" (decimal event)))) result
let index fold (get stack machine) -1 inner row ancestor
  if (and (> row handler) (> (get map_index ancestor) -1)) (get map_index ancestor) inner
let error if (and (> index -1) (case (text_find detail ",\"map_index\":" 0) true found false))
  (with detail reported (extra_fields (get detail reported) (concat "\"map_index\":" (decimal index)))) reported
let stack if (eq handler 0) (list {EvalFrame} 0)
  (fold parents (list {EvalFrame} 0) frames row frame
   if (< row handler) (append frames frame)
   if (eq row handler) (append frames (with trap (with cursor (with values frame (list {EvalValue} 1 (caught_value error))) 1) 0)) frames)
make EvalMachine stack stack remaining left answer error cache (get cache machine) memory (get memory machine) reads (get reads machine) read_left (get read_left machine) stream_left (get stream_left machine)

eval_return parents:*{EvalFrame} left:i result:{ScalarResult} machine:{EvalMachine} > {EvalMachine}
if (not (text_eq (get code result) "")) (unwind_error parents left result machine)
if (eq (length parents) 0) (make EvalMachine stack parents remaining left answer result cache (get cache machine) memory (get memory machine) reads (get reads machine) read_left (get read_left machine) stream_left (get stream_left machine))
let parent need (at parents (- (length parents) 1)) "return_frame" 0
let resumed with values parent (append (get values parent) (get value result))
make EvalMachine stack (append (eval_parents parents) resumed) remaining left answer result cache (get cache machine) memory (get memory machine) reads (get reads machine) read_left (get read_left machine) stream_left (get stream_left machine)

next_operand op:t values:*{EvalValue} count:i > i
let done length values
if (and (text_eq op "fold_rows") (eq done 4)) -1
if (and (text_eq op "fold_lines") (eq done 3)) -1
if (or (not (< done count)) (and (text_eq op "fold") (eq done 2))) -1
if (and (text_eq op "map") (> done 0)) -1
if (text_eq op "need")
  (if (eq done 0) 0 (if (get present (need (at values 0) "option" 0)) -1 done))
if (text_eq op "case")
  (if (eq done 0) 0 (if (eq done 2) -1 (if (get present (need (at values 0) "option" 0)) 2 1)))
if (text_eq op "if")
  (if (eq done 0) 0 (if (eq done 2) -1 (if (eq (get num (need (at values 0) "condition" 0)) 0) 2 1)))
if (and (eq done 1) (or (and (text_eq op "and") (eq (get num (need (at values 0) "lhs" 0)) 0))
                        (and (text_eq op "or") (eq (get num (need (at values 0) "lhs" 0)) 1)))) -1 done

lazy_operand op:t > b
or (or (text_eq op "if") (text_eq op "case")) (or (text_eq op "need") (or (text_eq op "and") (text_eq op "or")))

child_env op:t values:*{EvalValue} env:*{EvalValue} > *{EvalValue}
if (and (text_eq op "case") (eq (length values) 1))
  (let option need (at values 0) "case_value" 0
   if (get present option) (append env (with present option false)) env)
if (and (text_eq op "let") (eq (length values) 1)) (append env (need (at values 0) "let_value" 0)) env

leaf_value node:{FunctionNode} env:*{EvalValue} > {EvalValue}
if (text_eq (get word (get site node)) "tag") (with text (number_value (get value node)) (get literal node))
if (< (get slot node) 0) (if (text_eq (get typ node) "t") (text_value (get literal node)) (number_value (get value node))) (need (at env (get slot node)) "binding" 0)

operand_binding slot:i op:t values:*{EvalValue} env:*{EvalValue} > {EvalValue}
if (< slot (length env)) (need (at env slot) "binding" 0)
need (at (child_env op values env) slot) "local_binding" 0

record LeafRun
values:*{EvalValue} left:i stopped:b error:{ScalarResult}

immediate_projection node:{FunctionNode} tree:{FunctionTree} env:*{EvalValue} parent_op:t file:t acc:{LeafRun} > {LeafRun}
let site get site node
let op get word site
if (not (or (text_eq op "get") (or (text_eq op "first") (text_eq op "second")))) (with stopped acc true)
let child node_at (get nodes tree) (need (at (get children node) 0) "pair_operand" 0)
let slot get slot child
if (< slot 0) (with stopped acc true)
let left get left acc
if (< left 2)
  (let exhausted if (eq left 0) site (get site child)
   with stopped (with error acc (scalar_failure file exhausted "E_LIMIT" "Work budget exhausted" "")) true)
let values get values acc
let arg operand_binding slot parent_op values env
with left (with values acc (append values (project_member node arg))) (- left 2)

project_member node:{FunctionNode} value:{EvalValue} > {EvalValue}
let op get word (get site node)
if (text_eq op "get") (member_value value (get value node)) (pair_member value (text_eq op "first") (get typ node))

immediate_operands op:t kids:*i env:*{EvalValue} tree:{FunctionTree} file:t initial:{LeafRun} > {LeafRun}
fold (list i 3 0 1 2) initial acc row unused
  if (get stopped acc) acc
  let values get values acc
  let next next_operand op values (length kids)
  if (< next 0) (with stopped acc true)
  let index need (at kids next) "child" 0
  let node node_at (get nodes tree) index
  if (> (length (get children node)) 0) (immediate_projection node tree env op file acc)
  if (or (or (text_eq (get word (get site node)) "list") (text_eq (get word (get site node)) "dict")) (not (< (get target node) 0))) (with stopped acc true)
  if (eq (get left acc) 0) (with stopped (with error acc (scalar_failure file (get site node) "E_LIMIT" "Work budget exhausted" "")) true)
  let slot get slot node
  let value if (< slot 0) (leaf_value node env) (operand_binding slot op values env)
  with left (with values acc (append values value)) (- (get left acc) 1)

cache_entry cache:*{CallCache} slot:i entry:{CallCache} > *{CallCache}
fold cache (list {CallCache} 0) acc row old append acc (if (eq (- row 1) slot) entry old)

eval_step machine:{EvalMachine} program:{CheckedFunctions} observing:b > {EvalMachine}
let stack get stack machine
if (eq (length stack) 0) machine
let frame need (at stack (- (length stack) 1)) "active_frame" 0
let owner get owner frame
let tree need (at (get trees program) owner) "function_tree" 0
case (get scan_state frame) (ordinary_step machine program frame tree observing) scanning (scan_step machine program frame tree scanning observing)

ordinary_step machine:{EvalMachine} program:{CheckedFunctions} frame:{EvalFrame} tree:{FunctionTree} observing:b > {EvalMachine}
let stack get stack machine
let owner get owner frame
let node node_at (get nodes tree) (get node frame)
let site get site node
let op get word site
let fn need (at (get signatures program) owner) "function" 0
let file get file fn
let left - (get remaining machine) (if (get entered frame) 0 1)
let parents eval_parents stack
let cache get cache machine
if (eq (get started frame) -2) (eval_return parents left (value_ok (need (at (get values frame) 0) "recursive_result" 0)) machine)
if (not (< (get started frame) 0))
  (let value need (at (get values frame) 0) "call_result" 0
   let key get target node
   let slot mod key (length cache)
   let prior need (at cache slot) "cache_entry" 0
   let misses if (eq (get target prior) key) (+ 1 (get misses prior)) 0
   let entry make CallCache target key args (get env frame) value value work (- (get started frame) left) misses misses
   let updated cache_entry cache slot entry
   eval_return parents left (value_ok value) (with cache machine updated))
if (< left 0) (eval_return parents 0 (scalar_failure file site "E_LIMIT" "Work budget exhausted" "") machine)
if (text_eq op "while") (eval_while machine frame node parents left)
if (text_eq op "transaction") (eval_transaction machine frame node fn parents left)
if (and (get diagnostic node) (text_eq op "catch")) (eval_catch machine frame node parents left)
if (text_eq op "match")
  (let values get values frame
   let pending eq (length values) 0
   let next if pending 0 (match_arm node (need (at values 0) "variant_subject" 0))
   let child eval_frame owner (need (at (get children node) next) "match_child" 0) (get env frame)
   let path if pending (append parents (with entered frame true)) parents
   with remaining (with stack machine (append path child)) left)
let kids get children node
let operands if (or (eq (length kids) 0) (and observing (lazy_operand op)))
  (make LeafRun values (get values frame) left left stopped true error (scalar_ok 0))
  (immediate_operands op kids (get env frame) tree file (make LeafRun values (get values frame) left left stopped false error (scalar_ok 0)))
let error get error operands
if (not (text_eq (get code error) "")) (eval_return parents 0 error machine)
let values get values operands
let done length values
let remaining get left operands
let next next_operand op values (length kids)
if (not (< next 0))
  (let index need (at kids next) "expression_operand" 0
   let child eval_frame owner index (child_env op values (get env frame))
   let waiting with entered (with values frame values) true
   make EvalMachine stack (append (append parents waiting) child) remaining remaining answer (get answer machine) cache cache memory (get memory machine) reads (get reads machine) read_left (get read_left machine) stream_left (get stream_left machine))
if (get simple node) (eval_return parents remaining (completed_scalar node (get env frame) values file) machine)
if (get diagnostic node) (eval_return parents remaining (eval_diagnostic op site file values) machine)
collection_step machine frame node tree fn program values parents remaining observing

collection_step machine:{EvalMachine} frame:{EvalFrame} node:{FunctionNode} tree:{FunctionTree} fn:{Signature} program:{CheckedFunctions} values:*{EvalValue} parents:*{EvalFrame} remaining:i observing:b > {EvalMachine}
let site get site node
let file get file fn
let op get word site
let done length values
let kids get children node
let owner get owner frame
let cache get cache machine
if (text_eq op "write_bytes") (eval_return parents remaining (write_action (need (at values 0) "write_grant" 0) (need (at values 1) "write_data" 0) file site) machine)
if (https_op op)
  (let action https_action values file site
   let memory - (get memory machine) (get bytes action)
   if (< memory 0) (eval_return parents remaining (scalar_failure file site "E_LIMIT" "Guest allocation budget exhausted" "") machine)
   eval_return parents remaining (get result action) (with memory machine memory))
if (or (or (text_eq op "pg_query") (text_eq op "pg_exec")) (or (text_eq op "sql_exec") (text_eq op "sql_query")))
  (let action if (text_eq (text_slice op 0 3) "pg_") (pg_action values (get typ node) (get schemas fn) file site (get memory machine)) (sql_action values (get typ node) (get schemas fn) file site (get memory machine))
   eval_return parents remaining (get result action) (with memory machine (- (get memory machine) (get bytes action))))
if (public_data_op op)
  (let action data_operation op (if (text_eq op "json_encode") (get literal node) (get typ node)) values (get schemas fn) file site
   let work - remaining (get work action)
   let memory - (get memory machine) (get bytes action)
   if (< work 0) (eval_return parents 0 (scalar_failure file site "E_LIMIT" "Work budget exhausted" "") machine)
   if (< memory 0) (eval_return parents work (scalar_failure file site "E_LIMIT" "Guest allocation budget exhausted" "") machine)
   eval_return parents work (get result action) (with memory machine memory))
if (text_eq op "fold_rows") (eval_stream_rows machine parents frame node fn values remaining)
if (text_eq op "fold_lines") (eval_stream_lines machine parents frame node file values remaining)
if (text_eq op "read_batch")
  (let result batch_data (need (at values 0) "grant" 0) (get num (need (at values 1) "budget" 0)) (get stream_left machine) file site
   if (not (text_eq (get code result) "")) (eval_return parents remaining result machine)
   let n text_len (get text (get value result))
   let memory batch_memory (get memory machine) n
   let work batch_work remaining n
   if (or (< memory 0) (< work 0)) (eval_return parents 0 (scalar_failure file site "E_LIMIT" "Batch resources exhausted" "") machine)
   eval_return parents work result (with memory (with stream_left machine (- (get stream_left machine) n)) memory))
if (or (text_eq op "read") (text_eq op "read_bytes")) (eval_read (need (at values 0) "read_grant" 0) machine parents remaining file site)
if (text_eq op "get")
  (let record_value need (at values 0) "record_operand" 0
   eval_return parents remaining (value_ok (member_value record_value (get value node))) machine)
if (or (text_eq op "make") (text_eq op "with"))
  (eval_record machine parents remaining node fn values)
if (text_eq op "pair")
  (let a need (at values 0) "left" 0
   let b need (at values 1) "right" 0
   let available - (get memory machine) (pair_cost a b (get typ node))
   if (< available 0) (eval_return parents remaining (scalar_failure file site "E_LIMIT" "Guest allocation budget exhausted" "") machine)
   eval_return parents remaining (value_ok (pair_value a b (get typ node))) (with memory machine available))
if (or (text_eq op "first") (text_eq op "second"))
  (eval_return parents remaining (value_ok (pair_member (need (at values 0) "pair" 0) (text_eq op "first") (get typ node))) machine)
if (or (text_eq op "some") (or (text_eq op "case") (text_eq op "need")))
  (eval_option node file values machine parents remaining)
if (text_operation op) (eval_text node file values machine parents remaining)
if (text_eq op "map")
  (let direct if (and (not observing) (eq done 1)) (projected_map tree node frame (need (at values 0) "map_source" 0) machine parents remaining) (nil {EvalMachine})
   case direct (eval_map machine parents frame node file values remaining) result result)
if (text_eq op "fold")
  (let seq need (at values 0) "fold_source" 0
   let acc need (at values 1) "fold_start" 0
   let cursor get cursor frame
   let body need (at kids 2) "fold_body" 0
   let direct if (and (eq cursor 0) (> (length (get items seq)) 0))
     (numeric_fold tree body (get env frame) (get items seq) acc file remaining) (nil {FoldResult})
   case direct
     (case (sequence_item seq cursor) (eval_return parents remaining (value_ok acc) machine) item
   let env append (append (append (get env frame) acc) (number_value (+ cursor 1))) item
   let child eval_frame owner body env
   let waiting with cursor (with entered (with values frame (list {EvalValue} 1 seq)) true) (+ cursor 1)
   make EvalMachine stack (append (append parents waiting) child) remaining remaining answer (get answer machine) cache cache memory (get memory machine) reads (get reads machine) read_left (get read_left machine) stream_left (get stream_left machine))
     result (eval_return parents (get left result) (get result result) machine))
if (text_eq op "length")
  (let seq need (at values 0) "length_operand" 0
   eval_return parents remaining (scalar_ok (sequence_size seq)) machine)
if (text_eq op "at")
  (let item sequence_item (need (at values 0) "at_sequence" 0) (get num (need (at values 1) "at_index" 0))
   eval_return parents remaining (value_ok (case item (number_value 0) value (with present value true))) machine)
if (or (text_eq op "list") (text_eq op "append")) (eval_list machine parents remaining node file values)
if (text_eq op "recur")
  (let depth fold parents 0 n row ancestor + n (if (eq (get started ancestor) -2) 1 0)
   if (eq depth 48) (eval_return parents remaining (scalar_failure file site "E_LIMIT" "Recursion depth limit" "") machine)
   let marker with started (with entered (with values frame (list {EvalValue} 0)) true) -2
   with remaining (with stack machine (append (append parents marker) (eval_root program owner values))) remaining)
if (not (< (get target node) 0)) (eval_call machine program frame (get target node) values parents remaining)
eval_return parents remaining (completed_scalar node (get env frame) values file) machine

projected_map tree:{FunctionTree} node:{FunctionNode} frame:{EvalFrame} seq:{EvalValue} machine:{EvalMachine} parents:*{EvalFrame} left:i > ?{EvalMachine}
let n length (get members seq)
if (or (eq n 0) (not (or (text_eq (get typ node) "*i") (text_eq (get typ node) "*b")))) (nil {EvalMachine})
let body need (at (get children node) 1) "map_body" 0
let nodes get nodes tree
let start get subtree_start (node_at nodes body)
let depth - body start
let cost + 8 (* 16 n)
let work * n (+ depth 1)
if (or (> depth 48) (or (< left work) (< (get memory machine) cost))) (nil {EvalMachine})
if (not (eq (get slot (node_at nodes start)) (length (get env frame)))) (nil {EvalMachine})
let path fold (indices depth) (list {FunctionNode} 0) steps row unused
  let step node_at nodes (+ start row)
  let op get word (get site step)
  if (or (text_eq op "get") (or (text_eq op "first") (text_eq op "second"))) (append steps step) steps
if (not (eq depth (length path))) (nil {EvalMachine})
let nums map i (get members seq) relative
  (get num (fold path (member_from_offset seq relative) value row step project_member step value))
some (eval_return parents (- left work) (value_ok (list_value nums)) (with memory machine (- (get memory machine) cost)))

map_append result:{EvalValue} item:{EvalValue} typ:t bytes:i > {EvalValue}
if (scalar_type typ) (list_value (append (get items result) (get num item)))
if (text_eq typ "t") (text_list_value (append (get texts result) (get text item)))
add_member result "" typ item bytes

eval_map machine:{EvalMachine} parents:*{EvalFrame} frame:{EvalFrame} node:{FunctionNode} file:t values:*{EvalValue} left:i > {EvalMachine}
let seq need (at values 0) "map_sequence" 0
let kind get typ node
let typ text_slice kind 1 (text_len kind)
let output at values 2
let bytes case output 0 item (field_bytes item typ)
let available - (get memory machine) (+ 8 bytes)
if (< available 0) (eval_return parents left (scalar_failure file (get site node) "E_LIMIT" "Guest allocation budget exhausted" "") machine)
let acc case output (number_value 8) item (map_append (need (at values 1) "map_result" 0) item typ bytes)
let index + 1 (get map_index frame)
let charged with memory machine available
case (sequence_item seq index) (eval_return parents left (value_ok acc) charged) item
let env append (get env frame) item
let body need (at (get children node) 1) "map_body" 0
let waiting with map_index (with entered (with values frame (list {EvalValue} 2 seq acc)) true) index
make EvalMachine stack (append (append parents waiting) (eval_frame (get owner frame) body env)) remaining left answer (get answer machine) cache (get cache machine) memory available reads (get reads machine) read_left (get read_left machine) stream_left (get stream_left machine)

eval_record machine:{EvalMachine} parents:*{EvalFrame} remaining:i node:{FunctionNode} fn:{Signature} values:*{EvalValue} > {EvalMachine}
let site get site node
let op get word site
let file get file fn
let budget get memory machine
if (text_eq op "make")
  (let decl need (at (get entries (get schemas fn)) (get value node)) "record_constructor" 0
   let costs fold values (list i 0) acc row v append acc (field_bytes v (need (at (get types decl) (- row 1)) "field_type" 0))
   let cost fold costs 16 total row bytes + total bytes
   if (> cost budget) (eval_return parents remaining (scalar_failure file site "E_LIMIT" "Guest allocation budget exhausted" "") machine)
   let record_value fold values (number_value 16) acc row v
     let idx - row 1
     add_member acc (need (at (get fields decl) idx) "field_name" 0) (need (at (get types decl) idx) "field_type" 0) v (need (at costs idx) "field_cost" 0)
   eval_return parents remaining (value_ok record_value) (with memory machine (- budget cost)))
let previous need (at values 0) "record_operand" 0
let fresh need (at values 1) "field_value" 0
let idx get value node
let cost record_update_cost previous idx fresh
if (> cost budget) (eval_return parents remaining (scalar_failure file site "E_LIMIT" "Guest allocation budget exhausted" "") machine)
eval_return parents remaining (value_ok (updated_record previous idx fresh cost)) (with memory machine (- budget cost))

eval_list machine:{EvalMachine} parents:*{EvalFrame} remaining:i node:{FunctionNode} file:t values:*{EvalValue} > {EvalMachine}
let site get site node
let op get word site
let done length values
if (not (atom_type (text_slice (get typ node) 1 (text_len (get typ node)))))
  (eval_named_list machine parents remaining node file values)
if (text_eq (get typ node) "*t")
  (let extending text_eq op "append"
   let size if extending (+ 1 (length (get texts (need (at values 0) "append_sequence" 0)))) done
   if (> size 4096) (eval_return parents remaining (scalar_failure file site "E_LIMIT" "List length limit" "") machine)
   let texts if extending (append (get texts (need (at values 0) "append_sequence" 0)) (get text (need (at values 1) "append_item" 0)))
     (fold values (list t 0) acc row value append acc (get text value))
   return_strings texts machine parents remaining file site)
let extending text_eq op "append"
let base if extending (get items (need (at values 0) "append_sequence" 0)) (list i 0)
let size if extending (+ 1 (length base)) done
if (> size 4096) (eval_return parents remaining (scalar_failure file site "E_LIMIT" "List length limit" "") machine)
let memory - (get memory machine) (+ 8 (* 16 size))
if (< memory 0) (eval_return parents remaining (scalar_failure file site "E_LIMIT" "Guest allocation budget exhausted" "") machine)
let items if extending (append base (get num (need (at values 1) "append_item" 0))) (fold values (list i 0) acc row item append acc (get num item))
eval_return parents remaining (value_ok (list_value items)) (with memory machine memory)

eval_named_list machine:{EvalMachine} parents:*{EvalFrame} remaining:i node:{FunctionNode} file:t values:*{EvalValue} > {EvalMachine}
let site get site node
let extending text_eq (get word site) "append"
let typ text_slice (get typ node) 1 (text_len (get typ node))
let budget get memory machine
if extending
  (let base need (at values 0) "append_sequence" 0
   if (eq (length (get members base)) 4096) (eval_return parents remaining (scalar_failure file site "E_LIMIT" "List length limit" "") machine)
   let item need (at values 1) "append_item" 0
   let bytes field_bytes item typ
   let cost + (get num base) (+ 8 bytes)
   if (> cost budget) (eval_return parents remaining (scalar_failure file site "E_LIMIT" "Guest allocation budget exhausted" "") machine)
   eval_return parents remaining (value_ok (add_member base "" typ item bytes)) (with memory machine (- budget cost)))
let cost fold values 8 total row v + total (+ 8 (field_bytes v typ))
if (> cost budget) (eval_return parents remaining (scalar_failure file site "E_LIMIT" "Guest allocation budget exhausted" "") machine)
let items fold values (number_value 8) acc row v add_member acc "" typ v (field_bytes v typ)
eval_return parents remaining (value_ok items) (with memory machine (- budget cost))

eval_call machine:{EvalMachine} program:{CheckedFunctions} frame:{EvalFrame} callee:i values:*{EvalValue} parents:*{EvalFrame} remaining:i > {EvalMachine}
let cache get cache machine
let info need (at (get info program) callee) "call_info" 0
let profitable and (not (get allocates info)) (and (not (< (get work info) 8)) (and (not (> (length values) 16))
  (fold (get types (need (at (get signatures program) callee) "callee" 0)) true ok pos typ and ok (scalar_type typ))))
let slot mod callee (length cache)
let saved need (at cache slot) "call_cache" 0
let eligible and profitable (or (not (eq (get target saved) callee)) (< (get misses saved) 4))
let hit and profitable (and (eq (get target saved) callee) (and (not (> (get work saved) remaining))
  (fold values true ok row item and ok (eq (get num item) (get num (need (at (get args saved) (- row 1)) "cached_argument" 0))))))
if hit
  (let refreshed if (eq (get misses saved) 0) cache (cache_entry cache slot (with misses saved 0))
   eval_return parents (- remaining (get work saved)) (value_ok (get value saved)) (with cache machine refreshed))
let callers if eligible
