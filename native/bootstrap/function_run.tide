expected_wire ex:{FunctionExample} value:{EvalValue} kind:t > t
if (or (scalar_type kind) (or (text_eq kind "*i") (text_eq kind "*b"))) (need (json_at (get data ex) ".expect") "expected_value" 0)
scalar_wire value kind

sample_mismatch ex:{FunctionExample} sample:{SampleArgs} program:{CheckedFunctions} root_file:t result:{ScalarResult} compact:b > t
let idx get target sample
let code get code result
let fn need (at (get signatures program) idx) "definition" 0
let is_rule rule_signature fn
let kind if is_rule (concat "*" (get result fn)) (get result fn)
let expected get expected sample
let actual_value get value result
if (not (text_eq code ""))
  (let path_matches case (json_at (get data ex) ".expect_error.path") true token
     let details read_scalar_json (get detail result) internal_json false
     case (json_at details ".issue.path") false actual (text_eq (get value (string_token token)) (get value (string_token actual)))
   if (and path_matches (and (case (get line sample) true wanted (case (get line result) false found (eq wanted found))) (and (text_eq code (get error_code sample)) (case (json_at (get data ex) ".expect_error.reason") true specified (and (text_eq code "E_DATA") (text_eq (get reason sample) (get reason result))))))) ""
   let detail get detail result
   let prefix concat "{\"file\":" (json_string root_file)
   let actual if (text_eq (text_slice detail 0 (+ (text_len prefix) 1)) (concat prefix ","))
     (concat "{" (text_slice detail (+ (text_len prefix) 1) (text_len detail))) detail
   let want if (text_eq (get error_code sample) "") (expected_wire ex expected kind) (get error_wire sample)
   example_wrong ex "Example raised an unexpected error" want actual)
if (not (text_eq (get error_code sample) "")) (example_wrong ex "Expected an error" (get error_wire sample) (scalar_wire actual_value kind))
case (value_difference expected actual_value kind) "" diff
if is_rule
  (let path get path diff
   let pos need (int (text_slice path 1 (text_len path))) "event_index" 0
   let msg example_wrong ex "Wrong event output" (get expected diff) (get actual diff)
   extra_fields msg (concat "\"event\":" (decimal (+ pos 1))))
if (and compact (or (not (text_eq (get path diff) "")) (not (text_eq (get aspect diff) ""))))
  (extra_fields (diagnosis (get file ex) (get loc ex) "E_EXAMPLE" "Wrong output")
    (cat3 "\"example\":" (json_string (get name ex)) (concat "," (difference_fields diff))))
example_wrong ex "Wrong output" (expected_wire ex expected kind) (scalar_wire actual_value kind)

scan_continue machine:{EvalMachine} parents:*{EvalFrame} frame:{EvalFrame} scanning:{ScanState} child:?{EvalFrame} > {EvalMachine}
let next with values (with scan_state frame (some scanning)) (list {EvalValue} 0)
let stack append parents next
with stack machine (case child stack pending append stack pending)

scan_scope event:i fields:*{EvalValue} > *{EvalValue}
