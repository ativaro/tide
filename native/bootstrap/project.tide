use project_model

use function_run

use aot

test_release_matches catalog:t pin:?t > b
case (lookup catalog "release.lock") false release
case pin true contents text_eq (pin_status contents release) "ok"

project_output project:{ProjectFiles} fields:t > t
let modules fold (get units project) "" acc pos unit if (eq pos 1) acc (json_item acc (json_string (get name unit)))
cat3 "\"modules\":[" modules (cat3 "]," fields (concat "\n" (project_snapshot project)))

project_run project:{ProjectFiles} entry:t call:t inputs:t grants:*t > t
let root_unit need (at (get units project) 0) "missing_root" 0
let file get file root_unit
let compiled compile_project project (schema_blocks (get source root_unit) true)
let table get declarations compiled
let idx project_entry_index compiled call file
let fn need (at (get functions table) idx) "entry" 0
if (rule_signature fn) fail (root_diagnostic file "E_ENTRY" (concat "Expected function: " call))
let args run_arguments inputs fn grants (get file fn)
let result scalar_eval (get program compiled) idx args
if (text_eq (get code result) "") (concat (scalar_wire (get value result) (get result fn)) "\n") (fail (get detail result))

project_finish project:{ProjectFiles} entry:t call:t inputs:t > t
let units get units project
let action text_slice entry 0 1
if (text_eq action "#") (project_output project (project_imports units))
if (text_eq action "!") (project_run project entry call inputs (list t 0))
let root_unit need (at units 0) "missing_root" 0
let file get file root_unit
let blocks schema_blocks (get source root_unit) true
let compiled compile_project project blocks
if (or (text_eq action "A") (text_eq action "S")) (aot_program compiled call inputs file units (text_eq action "S"))
if (text_eq action "^") (project_trace compiled call inputs file)
if (text_eq action "?")
  (cat3 "{\"passed\":" (decimal (passed_examples compiled file)) "}\n")
let fields compiled_fields compiled
if (text_eq action "~")
  (let output format_unit blocks
   let result compiled_fields (compile_project project (schema_blocks output true))
   if (text_eq result fields) output (fail "format_changed_program"))
project_output project fields

module_checks > b
let root_text "use Box\n\nuse Flag\n\nrecord Result\nitem:{Box}"
let first_request project_begin root_text "" (text_len root_text) "entry.tide" "?entry.tide"
if (not (text_eq (get next_name first_request) "Box.tide")) fail "first_import"
let box_text "use Flag\n\nrecord Box\nphase:{Flag}"
let second_request project_supply first_request box_text "" (text_len box_text)
if (not (text_eq (get next_name second_request) "Flag.tide")) fail "transitive_import"
let done project_supply second_request "variant Flag\nyes no" "" 19
if (not (text_eq (get next_name done) "")) fail "duplicate_import"
if (not (text_eq (project_finish done "?entry.tide" "" "{}") "{\"passed\":0}\n")) fail "module_suite"
let formatted project_finish done "~entry.tide" "" "{}"
if (not (text_eq formatted (concat root_text "\n"))) fail "entry_format"
and package_checks (and (text_eq (project_escape 127) "\\u007f") (text_eq (project_escape 128512) "\\ud83d\\ude00"))

package_checks > b
let root "use alpha@1.0.0\n\nuse beta@2.0.0\n\nmerge a:{alpha.Result} b:{beta.Result} > i\n+ (get value a) (get value b)\n\nmain > i\nmerge (alpha.parse 1) (beta.parse 2)\n\nexample both main\n{\"inputs\":{},\"expect\":17}"
let alpha "package alpha 1.0.0\n\nuse helper\n\nuse beta@2.0.0\n\nexport parse Result\n\nrecord Result\nvalue:i\n\nparse n:i > {Result}\nmake Result value (adjust (get value (beta.parse n)))\n\nexample same parse\n{\"inputs\":{\"n\":1},\"expect\":{\"value\":13}}"
let beta "package beta 2.0.0\n\nexport parse Result\n\nrecord Result\nvalue:i\n\nparse n:i > {Result}\nmake Result value (+ n 2)\n\nexample same parse\n{\"inputs\":{\"n\":1},\"expect\":{\"value\":3}}"
let helper "adjust n:i > i\n+ n 10"
let request project_begin root (ascii_string root) (text_len root) "panel.tide" "?panel.tide"
if (not (text_eq (get next_name request) "vendor/alpha/1.0.0/package.tide")) fail "versioned_path"
let with_alpha project_supply request alpha (ascii_string alpha) (text_len alpha)
if (not (text_eq (get next_name with_alpha) "vendor/alpha/1.0.0/helper.tide")) fail "package_sibling"
let with_helper project_supply with_alpha helper (ascii_string helper) (text_len helper)
let done project_supply with_helper beta (ascii_string beta) (text_len beta)
if (not (and (text_eq (get next_name done) "") (text_eq (project_finish done "?panel.tide" "" "{}") "{\"passed\":3}\n"))) fail "package_examples"
let book get declarations (compile_project done (schema_blocks root true))
let scope get entry_scope book
case (scope_index (get calls scope) (get names book) "alpha.adjust" (get space scope)) true hidden false

example shared_module module_checks
{"inputs":{},"expect":true}

selected_fields text:t fields:*t file:t > *t
let invalid root_diagnostic file "E_NAME" "Unknown state field"
let n + (text_len text) 1
let parsed fold (indices (chunk_count n)) (pair (list t 0) 0) held batch unused
  let base * (- batch 1) 2048
  let left - n base
  fold (indices (if (< left 2048) left 2048)) held acc pos skip
    let index + base (- pos 1)
    if (not (or (eq index (text_len text)) (text_eq (text_slice text index (+ index 1)) ","))) acc
    let key text_slice text (second acc) index
    if (case (entry_at fields key) true found false) fail invalid
    let keys first acc
    pair (case (entry_at keys key) (append keys key) found keys) (+ index 1)
first parsed

project_trace compiled:{CompiledProject} name:t options:t file:t > t
let book get declarations compiled
let index need (entry_at (get sample_names book) name) (root_diagnostic file "E_EXAMPLE" (concat "Unknown example: " name)) 0
let sample need (at (get samples compiled) index) "trace_sample" 0
let target get target sample
let program get program compiled
let fn need (at (get signatures program) target) "trace_definition" 0
if (not (rule_signature fn)) fail (root_diagnostic file "E_TYPE" "Trace needs a rule example")
let n text_len options
let cut case (text_find options "|" 0) n offset offset
let raw text_slice options 0 cut
let digits if (text_eq (text_slice raw 0 1) "+") (text_slice raw 1 (text_len raw)) raw
if (and (text_eq (text_slice raw 0 1) "+") (text_eq (text_slice digits 0 1) "-")) fail "defer_check"
let step case (int digits) (if (integer_token digits) -1 (fail "defer_check")) value value
let args get args sample
let size length (get items (need (at args 0) "trace_events" 0))
if (or (< step 1) (> step size)) fail (root_diagnostic file "E_INPUT" "Event index outside example")
let plan get plan (need (at (get trees program) target) "trace_rule" 0)
let fields get fields plan
let chosen if (eq cut n) fields (selected_fields (text_slice options (+ cut 1) n) fields file)
let result evaluate_call program target args (some (make TraceRequest step step fields chosen))
if (text_eq (get code result) "") (concat (extra_fields (get trace result) (concat "\"example\":" (json_string name))) "\n") (fail (get detail result))

project_example project:{ProjectFiles} name:t grants:*t > t
let unit need (at (get units project) 0) "example_root" 0
let file get file unit
let compiled compile_project project (schema_blocks (get source unit) true)
let table get declarations compiled
let idx need (entry_at (get sample_names table) name) (root_diagnostic file "E_EXAMPLE" (concat "Unknown example: " name)) 0
let ex need (at (get examples table) idx) "example_index" 0
let sample need (at (get samples compiled) idx) "sample_index" 0
let program get program compiled
let fn need (at (get signatures program) (get target sample)) "example_function" 0
let loc get loc ex
let bindings grant_bindings grants file loc
let required typed_grants fn "p"
let supplied get names bindings
let valid and (eq (length required) (length supplied)) (fold required true ok row key and ok (case (entry_at supplied (concat "~" key)) false found true))
if (not valid) fail (diagnosis file loc "E_CAPABILITY" "Supply the declared PostgreSQL example grants with --pg")
let args fold (get args sample) (list {EvalValue} 0) acc row arg
  let key need (at (get params fn) (- row 1)) "example_parameter" 0
  case (entry_at supplied (concat "~" key)) (append acc arg) pos (append acc (text_value (need (at (get paths bindings) pos) "example_grant" 0)))
let result scalar_eval program (get target sample) args
let mismatch sample_mismatch ex sample program file result false
if (not (text_eq mismatch "")) fail mismatch
if (not (text_eq (get code result) "")) (cat3 "{\"passed\":1,\"error\":" (get detail result) "}\n")
let kind if (rule_signature fn) (concat "*" (get result fn)) (get result fn)
cat3 "{\"passed\":1,\"actual\":" (scalar_wire (get value result) kind) "}\n"
