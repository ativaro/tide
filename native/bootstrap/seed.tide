  "#include <sys/file.h>"
  "#include <sys/random.h>"
  "struct R_ProjectGrant {"
  "    SourcePath target;"
  "    project_io::ProjectDirectory project;"
  "    Text entry;"
  "    std::string candidate;"
  "    InputFD dir;"
  "    bool writable;"
  "    Failure error(const std::string& where,int code) const{"
  "        return {f_project_error(entry,decode(where),code,decode(strerror(code))),0};"
  "    }"
  "    R_ProjectGrant(const std::string& path,const Text& file,const std::string& input,bool write) try"
  "        :target(path),project(target.folder),entry(file),candidate(input),dir(open(target.folder.c_str(),O_RDONLY|O_DIRECTORY|O_CLOEXEC)),writable(write){"
  "        if(dir.fd<0)throw error(path,errno);"
  "        project_io::acquire(project,write);"
  "    }catch(const std::system_error& e){throw Failure{f_project_error(file,decode(path),e.code().value(),decode(strerror(e.code().value()))),0};}"
  "};"
  "R_ProjectFiles t_bootstrap_project(const R_ProjectGrant& io,const Opt<std::pair<Text,Text>>& root){"
  "    std::optional<std::pair<Text,I>> overlay;"
  "    if(root){"
  "        auto size=encode(root->second).size();if(size>131072)throw Failure{\"input_limit\",0};"
  "        overlay.emplace(root->second,I(size));"
  "    }"
  "    return load_project(io.dir.fd,io.target,io.entry,overlay?&*overlay:nullptr,root?root->first:Text{},f_project_begin,f_project_supply,f_project_escape,f_project_error);"
  "}"
  "Text t_bootstrap_candidate(const R_ProjectGrant& io){"
  "    return read_unit_at(AT_FDCWD,io.candidate,false,[&](int code){return io.error(io.candidate,code);}).first;"
  "}"
  "struct StagedFile {"
  "    const R_ProjectGrant& io;"
  "    std::string name,target;"
  "    StagedFile(const R_ProjectGrant& grant,std::string file):io(grant),target(std::move(file)){}"
  "    ~StagedFile(){if(!name.empty())unlinkat(io.dir.fd,name.c_str(),0);}"
  "};"
  "std::unique_ptr<StagedFile> t_bootstrap_stage(const R_ProjectGrant& io,const R_SourceUnit& unit,const Text& content){"
  "    auto target=encode(unit.v_name);if(target.empty()||target==\".\"||target==\"..\"||target.find('/')!=target.npos||target.find(char(0))!=target.npos)throw Failure{\"invalid_sibling_request\",0};"
  "    auto error=[&](int code){return io.error(io.target.sibling(target),code);};"
  "    if(!io.writable)throw error(EACCES);"
  "    struct stat st;if(fstatat(io.dir.fd,target.c_str(),&st,AT_SYMLINK_NOFOLLOW)<0)throw error(errno);"
  "    if(!S_ISREG(st.st_mode))throw Failure{\"regular_file_required\",0};"
  "    auto staged=std::make_unique<StagedFile>(io,target);"
  "    std::string name;int fd;"
  "    do{"
  "        uint64_t nonce;ssize_t n;"
  "        do{n=getrandom(&nonce,sizeof nonce,0);}while(n<0&&errno==EINTR);"
  "        if(n!=sizeof nonce)throw error(n<0?errno:EIO);"
  "        name=\".tide-edit.\"+std::to_string(nonce);"
  "        fd=openat(io.dir.fd,name.c_str(),O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);"
  "    }while(fd<0&&errno==EEXIST);"
  "    if(fd<0)throw error(errno);"
  "    InputFD output(fd);staged->name=std::move(name);"
  "    auto bytes=encode(content);"
  "    for(size_t at=0;at<bytes.size();){"
  "        auto n=write(fd,bytes.data()+at,bytes.size()-at);"
  "        if(n<0&&errno==EINTR)continue;"
  "        if(n<=0)throw error(n<0?errno:EIO);"
  "        at+=size_t(n);"
  "    }"
  "    if(fchmod(fd,st.st_mode&07777)<0||fsync(fd)<0)throw error(errno);"
  "    return staged;"
  "}"
  "bool t_bootstrap_commit(const std::unique_ptr<StagedFile>& staged){"
  "    const auto& io=staged->io;int dir=io.dir.fd;"
  "    if(renameat(dir,staged->name.c_str(),dir,staged->target.c_str())<0)throw io.error(io.target.sibling(staged->target),errno);"
  "    staged->name.clear();"
  "    if(fsync(dir)<0)throw io.error(io.target.folder,errno);"
  "    return true;"
  "}"
  project_stage_abi
