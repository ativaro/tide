 "Seq<Text> grants;for(int i=6;i<argc;++i)grants=t_append(std::move(grants),decode(argv[i]));auto finish=[&](const auto& s,const Text& e,const Text& c,const Text& in){return f_project_run(s,e,c,in,grants);};auto output=read_siblings(argv[2],decode(argv[3]),decode(argv[4]),decode(argv[5]),f_project_begin,f_project_supply,finish,f_project_escape,f_project_error);std::cout<<output<<std::flush;return std::cout?0:74;}"

