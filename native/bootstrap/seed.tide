  "    Text file;try{file=decode(filename);}catch(const std::range_error&){return 75;}"
  "    try{"
  "        auto output=read_siblings(path,U\"?\"+file,Text{},Text(U\"{}\"),f_project_begin,f_project_supply,f_project_finish,f_project_escape,f_project_error);"
  "        std::cout<<output<<std::flush;"
  "        if(std::cout)return 0;"
  "        std::cerr<<\"Could not write TIDE output.\\n\";return 1;"
  "    }catch(const Failure& e){"
  "        if(e.reason.starts_with(U\"{\\\"file\\\":\"))std::cerr<<e.reason<<'\\n';"
  "        else if(e.reason==U\"E_UTF8\" || e.reason==U\"input_limit\" || e.reason==U\"regular_file_required\")std::cerr<<f_check_schema(file,e.reason)<<'\\n';"
  "        else return 3;"
  "        return 1;"
  "    }catch(const std::range_error& e){"
  "        if(std::string_view(e.what())!=\"E_UTF8\")return 3;"
  "        std::cerr<<f_check_schema(file,Text(U\"E_UTF8\"))<<'\\n';return 1;"
  "    }catch(const std::exception&){return 3;}"
  "}"
  "// AT_EXECFN also identifies a PATH or symlink invocation in a filesystem without /proc."
  "std::string installed_cli(){"
  "    const char* executed=reinterpret_cast<const char*>(getauxval(AT_EXECFN));"
  "    if(!executed)return {};"
  "    std::unique_ptr<char,decltype(&std::free)> exe(realpath(executed,nullptr),&std::free);"
  "    if(!exe)return {};"
  "    SourcePath path(exe.get());"
  "    return path.name==\"tide\"?SourcePath(path.folder).folder:std::string{};"
  "}"
  "int cli_fallback(const std::string& root,char** argv){"
  "    execv((root+\"/tide\").c_str(),argv);std::cerr<<\"Could not start TIDE launcher.\\n\";return 1;"
  "}"
  "bool plain_cli_test(int argc,char** argv){"
  "    if(argc!=3 || std::string_view(argv[1])!=\"test\" || !argv[2][0] || argv[2][0]=='-')return false;"
  "    struct utsname os;return uname(&os)==0 && std::string_view(os.sysname)==\"Linux\" && std::string_view(os.machine)==\"x86_64\";"
  "}"
