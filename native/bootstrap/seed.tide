  "template<class T,bool P=std::is_class_v<T>> class Seq;"
  "template<class T> class Seq<T,false> {"
  "  using Buffer=std::vector<T>;"
  "  std::shared_ptr<Buffer> storage;"
  "  const Buffer& view() const {static const Buffer empty;return storage?*storage:empty;}"
  "public:"
  "  Seq()=default;"
  "  Seq(std::initializer_list<T> values):storage(std::make_shared<Buffer>(values)){}"
  "  size_t size() const {return storage?storage->size():0;}"
  "  auto begin() const {return view().cbegin();}"
  "  auto end() const {return view().cend();}"
  "  typename Buffer::const_reference operator[](size_t i) const {return view()[i];}"
  "  void push_back(T v){"
  "    if(!storage)storage=std::make_shared<Buffer>();"
  "    else if(storage.use_count()!=1)storage=std::make_shared<Buffer>(*storage);"
  "    storage->push_back(std::move(v));"
  "  }"
  "};"
  "template<class T> class Seq<T,true> {"
  "    using Buffer=std::vector<T>;"
  "    using Pages=std::vector<std::shared_ptr<const Buffer>>;"
  "    static constexpr size_t width=16;"
  "    std::shared_ptr<Pages> full;"
  "    std::shared_ptr<Buffer> tail;"
  "    struct Iterator {"
  "        const Seq* seq;size_t index;"
  "        bool operator!=(const Iterator& other) const{return index!=other.index;}"
  "        Iterator& operator++(){++index;return *this;}"
  "        typename Buffer::const_reference operator*() const{return (*seq)[index];}"
  "    };"
  "public:"
  "    Seq()=default;"
  "    Seq(std::initializer_list<T> values){"
  "        if(values.size()<=width)tail=std::make_shared<Buffer>(values);"
  "        else for(const auto& v:values)push_back(v);"
  "    }"
  "    size_t size() const{return (full?full->size()*width:0)+(tail?tail->size():0);}"
  "    Iterator begin() const{return {this,0};}"
  "    Iterator end() const{return {this,size()};}"
  "    typename Buffer::const_reference operator[](size_t i) const{"
  "        if(!full)return (*tail)[i];"
  "        auto page=i/width;"
  "        return page==full->size()?(*tail)[i%width]:(*(*full)[page])[i%width];"
  "    }"
  "    void push_back(T v){"
  "        if(!tail)tail=std::make_shared<Buffer>();"
  "        else if(tail->size()==width){"
  "            if(!full)full=std::make_shared<Pages>();"
  "            else if(full.use_count()!=1)full=std::make_shared<Pages>(*full);"
  "            full->push_back(tail);tail=std::make_shared<Buffer>();"
  "        }else if(tail.use_count()!=1)tail=std::make_shared<Buffer>(*tail);"
  "        tail->push_back(std::move(v));"
  "    }"
  "};"
