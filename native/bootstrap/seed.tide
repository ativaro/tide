let rows list t 55
  "// Positional reads keep nested folds and snapshot reads independent."
  "std::pair<I,std::pair<I,Text>> t_bootstrap_line(I fd,const Text& fixture,I offset,I limit){"
  "    struct Window { I fd=-999, start=0, used=0; char data[65536]; std::string example; };"
  "    static thread_local Window w;"
  "    if(w.fd!=fd || offset==0){w.fd=fd;w.used=0;if(fd<0)w.example=encode(fixture);}"
  "    std::string carry;"
  "    I consumed=0;"
  "    for(;;){"
  "        I pos=offset+consumed, left=limit-consumed;"
  "        std::string_view view;"
  "        if(fd<0){view=std::string_view(w.example).substr(size_t(pos));}"
  "        else {"
  "            if(!w.used || pos<w.start || pos>=w.start+w.used){"
  "                ssize_t n;do{n=pread(int(fd),w.data,std::min<I>(sizeof w.data,left+1),pos);}while(n<0 && errno==EINTR);"
  "                if(n<0)return {-1,{consumed,{}}};"
  "                w.start=pos;w.used=n;"
  "            }"
  "            view={w.data+(pos-w.start),size_t(w.used-(pos-w.start))};"
  "        }"
  "        view=view.substr(0,size_t(left+1));"
  "        auto lf=view.find('\\n');bool ended=lf!=view.npos;"
  "        I count=ended?I(lf)+1:I(view.size());"
  "        if(count>left)return {-2,{limit,{}}};"
  "        if(consumed+count>131072)return {-4,{consumed+count,{}}};"
  "        consumed+=count;"
  "        if(!ended && !view.empty()){carry.append(view);continue;}"
  "        if(!consumed)return {0,{0,{}}};"
  "        auto body=view.substr(0,ended?lf:0);"
  "        if(!carry.empty()){carry.append(body);body=carry;}"
  "        if(ended && !body.empty() && body.back()=='\\r')body.remove_suffix(1);"
  "        try{"
  "            if(std::all_of(body.begin(),body.end(),[](unsigned char c){return c<128;}))"
  "                return {1,{consumed,Text(body.begin(),body.end())}};"
  "            return {1,{consumed,decode(std::string(body))}};"
  "        }catch(const std::range_error&){return {-3,{consumed,{}}};}"
  "    }"
  "}"
  "I t_bootstrap_open_read(const Text& path){"
  "    auto name=encode(path);if(name.find(char(0))!=name.npos)return -1;"
  "    int fd=open(name.c_str(),O_RDONLY|O_NONBLOCK|O_CLOEXEC);if(fd<0)return -1;"
  "    struct stat st;if(fstat(fd,&st)){close(fd);return -1;}"
  "    if(!S_ISREG(st.st_mode)){close(fd);return -2;}return fd;"
  "}"
  "std::pair<I,Text> t_bootstrap_read_bytes(I fd,I limit){"
  "    char block[8192];std::string bytes;"
  "    for(;;){"
  "        auto n=pread(int(fd),block,std::min<I>(sizeof block,limit+1-I(bytes.size())),off_t(bytes.size()));"
  "        if(n<0&&errno==EINTR)continue;"
  "        if(n<0)return {-1,{}};"
  "        if(!n)break;"
  "        if(I(bytes.size())+n>limit)return {-2,{}};"
  "        bytes.append(block,n);"
  "    }"
  "    Text raw;raw.reserve(bytes.size());for(unsigned char byte:bytes)raw+=byte;return {I(bytes.size()),std::move(raw)};"
  "}"
