use syntax

record Lex
tokens:*t word:t quote:b escaped:b

record Term
raw:t cpp:t stable:b access:t

record Decl
head:t body:*t

record Blocks
done:*{Decl} head:t body:*t

record Product
records:t forwards:t functions:t entry:t

flush_lex cursor:{Lex} > {Lex}
if (text_eq (get word cursor) "") cursor
make Lex tokens (append (get tokens cursor) (get word cursor)) word "" quote false escaped false

lex_char cursor:{Lex} ch:t display:b gaps:t > {Lex}
let buffer concat (get word cursor) ch
if (get quote cursor)
  (let escaped get escaped cursor
   if (and (not display) (and escaped (case (text_find "\"\\nrtbfu" ch 0) true found false))) fail "bootstrap_string_escape"
   let closed and (not escaped) (text_eq ch "\"")
   let next make Lex tokens (get tokens cursor) word buffer quote (not closed) escaped (and (not escaped) (text_eq ch "\\"))
   if closed (flush_lex next) next)
if (white ch gaps) (flush_lex cursor)
if (text_eq ch "\"")
  (if (and (not display) (not (text_eq (get word cursor) ""))) (fail "bootstrap_quoted_token")
   (make Lex tokens (get tokens (flush_lex cursor)) word ch quote true escaped false))
if (or (text_eq ch "(") (text_eq ch ")"))
  (let prev flush_lex cursor
   with tokens prev (append (get tokens prev) ch))
with word cursor buffer

line_tokens line:t display:b gaps:t > *t
let start make Lex tokens (list t 0) word "" quote false escaped false
let end_state fold (indices (text_len line)) start cursor row ignored lex_char cursor (text_slice line (- row 1) row) display gaps
if (get quote end_state) fail "bootstrap_unclosed_string"
get tokens (flush_lex end_state)

tokens line:t > *t
line_tokens line false " \t\r"

identifier name:t > t
if (valid_id name) name (fail "bootstrap_identifier")

cpp_type typ:t > t
if (text_eq typ "r") "Text"
get target (need (data_shape typ) "bootstrap_data_type" 0)

raw_at parts:*{Term} index:i > t
get raw (need (at parts index) "bootstrap_operand" index)

expr_at parts:*{Term} index:i > t
let value get cpp (need (at parts index) "bootstrap_operand" index)
if (text_eq value "") fail "bootstrap_invalid_expression" value

joined parts:*{Term} start:i > t
fold parts "" acc row term
  if (< row (+ start 1)) acc (concat acc (concat (if (eq row (+ start 1)) "" ",") (expr_at parts (- row 1))))

call_cpp name:t args:t > t
cat3 name "(" (concat args ")")

var_cpp name:t > t
concat "v_" (identifier name)

integer_code value:i > t
if (eq value -9223372036854775808) "std::numeric_limits<I>::min()"
if (< value 0) (cat3 "I{-" (decimal (- 0 value)) "LL}")
cat3 "I{" (decimal value) "LL}"

atom token:t > {Term}
let first_ch text_slice token 0 1
let lit if (text_eq first_ch "\"") (cat3 "literal<U" token ">()")
  (if (or (text_eq token "true") (text_eq token "false")) token
   (case (int token) (if (valid_id token) (concat "v_" token) "") number (integer_code number)))
make Term raw token cpp lit stable (text_eq (text_slice lit 0 2) "v_") access ""

op_call op:t parts:*{Term} > t
let args joined parts 1
if (text_eq (text_slice op 0 13) "bootstrap_pg_") (call_cpp (concat "t_" op) args)
if (text_eq op "bootstrap_replace") (call_cpp "t_bootstrap_replace" args)
if (text_eq op "bootstrap_https") (call_cpp "t_bootstrap_https" args)
if (text_eq (text_slice op 0 14) "bootstrap_sql_") (sqlite_abi_call (text_slice op 14 (text_len op)) parts)
if (text_eq op "+") (call_cpp "add" args)
if (text_eq op "-") (call_cpp "sub" args)
if (text_eq op "*") (call_cpp "mul" args)
if (text_eq op "div") (call_cpp "quot" args)
if (text_eq op "mod") (call_cpp "remd" args)
if (text_eq op "bootstrap_rotr32")
  (cat3 "I(std::rotr(std::uint32_t(" (expr_at parts 1) (cat3 "),int((" (expr_at parts 2) ")%32)))"))
if (text_eq op "bootstrap_bit_and") (call_cpp "std::bit_and<I>{}" args)
if (text_eq op "bootstrap_bit_xor") (call_cpp "std::bit_xor<I>{}" args)
if (text_eq op "eq") (call_cpp "equal_i" args)
if (text_eq op "<") (call_cpp "less_i" args)
if (text_eq op ">") (call_cpp "more_i" args)
if (text_eq op "<=") (cat3 "(!more_i(" args "))")
if (text_eq op ">=") (cat3 "(!less_i(" args "))")
if (text_eq op "pair") (call_cpp "std::make_pair" args)
if (and (or (text_eq op "first") (text_eq op "second")) (get stable (need (at parts 1) "bootstrap_pair" 0)))
  (cat3 "(" (expr_at parts 1) (concat ")." op))
let native list t 29 "bootstrap_octets_utf8" "bootstrap_character" "bootstrap_project" "bootstrap_candidate" "bootstrap_stage" "bootstrap_stage_set" "bootstrap_install" "bootstrap_arm" "bootstrap_commit" "bootstrap_utf8_octets" "bootstrap_code_at" "text_eq" "text_len" "text_slice" "text_find" "text_rfind" "concat" "length" "append" "at" "lines" "int" "some" "read" "first" "second" "bootstrap_open_read" "bootstrap_read_bytes" "bootstrap_line"
if (fold native false hit row key or hit (text_eq key op)) (call_cpp (concat "t_" op) args)
call_cpp (concat "f_" (identifier op)) args

throws_value expr:t > b
text_eq (text_slice expr 0 7) "(throw "

failure_value expr:t > t
text_slice expr 7 (- (text_len expr) 1)

return_code expr:t > t
if (throws_value expr) (concat expr ";") (cat3 "return " expr ";")

match_code parts:*{Term} > t
let n length parts
if (or (< n 5) (not (text_eq (raw_at parts (- n 1)) "end"))) fail "bootstrap_match_end"
let arms fold parts "" body row item
  if (or (< row 3) (or (eq row n) (eq (mod row 2) 0))) body
  concat body (cat3 "case V::" (var_cpp (get raw item)) (concat ":" (return_code (expr_at parts row))))
let count decimal (div (- n 3) 2)
cat3 "([&](){auto choice=" (expr_at parts 1)
  (cat3 ";using V=decltype(choice);static_assert(int(V::tide_count)==" count
   (cat3 ",\"incomplete TIDE match\");switch(choice){" arms "}throw Failure{\"bootstrap_match\",0};}())"))

lower parts:*{Term} > t
let op raw_at parts 0
if (text_eq op "tag") (cat3 "R_" (identifier (raw_at parts 1)) (concat "::" (var_cpp (raw_at parts 2))))
if (text_eq op "match") (match_code parts)
if (text_eq op "if")
  (let yes expr_at parts 2
   let no expr_at parts 3
   if (and (throws_value yes) (throws_value no))
     (cat3 "(throw (" (expr_at parts 1) (cat3 "?" (failure_value yes) (cat3 ":" (failure_value no) "))")))
   cat3 "(" (expr_at parts 1) (cat3 "?" yes (cat3 ":" no ")")))
if (text_eq op "not") (cat3 "(!" (expr_at parts 1) ")")
if (or (text_eq op "and") (text_eq op "or"))
  (cat3 "(" (expr_at parts 1) (cat3 (if (text_eq op "and") "&&" "||") (expr_at parts 2) ")"))
if (text_eq op "let")
  (let body expr_at parts 3
   let prefix cat3 "([&](){const auto& " (var_cpp (raw_at parts 1)) (cat3 "=" (expr_at parts 2) ";return ")
   if (throws_value body) (cat3 "(throw " prefix (concat (failure_value body) ";}()))"))
   cat3 prefix body ";}())")
if (text_eq op "bootstrap_recover")
  (cat3 "([&](){try{return " (expr_at parts 1) (cat3 ";}catch(const Failure&){return " (expr_at parts 2) ";}}())"))
if (text_eq op "bootstrap_while")
  (let state var_cpp (raw_at parts 2)
   cat3 "([&](){auto " state (cat3 "=" (expr_at parts 1)
     (cat3 ";while(" (expr_at parts 3) (cat3 "){" state (cat3 "=" (expr_at parts 4) (cat3 ";}return " state ";}())"))))))
if (text_eq op "map")
  (let item var_cpp (raw_at parts 3)
   let seq expr_at parts 2
   let body expr_at parts 4
   let step if (throws_value body) (concat body ";") (cat3 "result.push_back(" body ");")
   if (throws_value seq) seq
   cat3 "([&](){const auto& seq=" seq
     (cat3 ";Seq<" (cpp_type (raw_at parts 1)) (cat3 "> result;for(const auto& " item
       (cat3 ":seq){" step "}return result;}())"))))
if (text_eq op "fold")
  (let acc var_cpp (raw_at parts 3)
   let row_name var_cpp (raw_at parts 4)
   let item var_cpp (raw_at parts 5)
   cat3 "([&](){const auto& seq=" (expr_at parts 1)
     (cat3 ";auto " acc (cat3 "=" (expr_at parts 2)
      (cat3 ";I " row_name (cat3 "=0;for(const auto& " item
       (cat3 ":seq){++" row_name (cat3 ";" acc (cat3 "=" (expr_at parts 6) (cat3 ";}return " acc ";}())")))))))))
if (text_eq op "case")
  (let empty expr_at parts 2
   let full expr_at parts 4
   let both and (throws_value empty) (throws_value full)
   let none_code if both (return_code (failure_value empty)) (return_code empty)
   let some_code if both (return_code (failure_value full)) (return_code full)
   let branch cat3 "([&](){const auto& opt=" (expr_at parts 1) (cat3 ";if(!opt){" none_code
     (cat3 "}const auto& " (var_cpp (raw_at parts 3)) (cat3 "=*opt;" some_code "}())")))
   if both (cat3 "(throw " branch ")") branch)
if (text_eq op "need")
  (let access get access (need (at parts 1) "bootstrap_operand" 1)
   if (not (text_eq access ""))
     (cat3 access "([&](){return Failure{" (cat3 (expr_at parts 2) "," (concat (expr_at parts 3) "};}))")))
   cat3 "([&](){const auto& opt=" (expr_at parts 1)
     (cat3 ";if(!opt)throw Failure{" (expr_at parts 2) (cat3 "," (expr_at parts 3) "};return *opt;}())")))
if (text_eq op "fail") (cat3 "(throw Failure{" (expr_at parts 1) ",0})")
if (text_eq op "list")
  (let n need (int (raw_at parts 2)) "bootstrap_count" 0
   if (not (eq n (- (length parts) 3))) (fail "bootstrap_list_arity")
   cat3 "Seq<" (cpp_type (raw_at parts 1)) (cat3 ">{" (joined parts 3) "}"))
if (text_eq op "nil") (cat3 "Opt<" (cpp_type (raw_at parts 1)) ">{}")
if (text_eq op "get") (cat3 "(" (expr_at parts 2) (concat ").v_" (identifier (raw_at parts 1))))
if (text_eq op "with") (cat3 "([&](){auto obj=" (expr_at parts 2) (cat3 ";obj." (var_cpp (raw_at parts 1))
  (cat3 "=" (expr_at parts 3) ";return obj;}())")))
if (text_eq op "make")
  (let fields fold parts "" body row term
    if (or (< row 3) (eq (mod row 2) 0)) body
    (concat body (cat3 (if (eq row 3) "." ",.") (var_cpp (get raw term)) (concat "=" (expr_at parts row))))
   cat3 "R_" (identifier (raw_at parts 1)) (cat3 "{" fields "}"))
op_call op parts

record Vocabulary
names:*t arities:*i types:*t widths:*i

record Pending
parts:*{Term} parent:i target:i grouped:b depth:i

record Reader
current:{Pending} saved:*{Pending} opening:b display:b

record_fields decl:{Decl} gaps:t > *t
fold (get body decl) (list t 0) fields row line
  fold (line_tokens line false gaps) fields acc pos field append acc field

symbols decls:*{Decl} gaps:t > {Vocabulary}
let start make Vocabulary names (list t 0) arities (list i 0) types (list t 0) widths (list i 0)
fold decls start env row decl
  let sig line_tokens (get head decl) false gaps
  let op need (at sig 0) "bootstrap_head" 0
  if (or (text_eq op "use") (or (text_eq op "example") (or (text_eq op "variant") (text_eq op "rule")))) env
  if (text_eq op "record")
    (let name need (at sig 1) "bootstrap_record" 0
     let width length (record_fields decl gaps)
     with widths (with types env (append (get types env) name)) (append (get widths env) width))
  with arities (with names env (append (get names env) op)) (append (get arities env) (- (length sig) 3))

raw_position op:t pos:i > b
if (text_eq op "tag") true
if (text_eq op "match") (eq (mod pos 2) 0)
if (text_eq op "make") (or (eq pos 1) (eq (mod pos 2) 0))
if (text_eq op "list") (< pos 3)
if (text_eq op "map") (or (eq pos 1) (eq pos 3))
if (text_eq op "fold") (and (> pos 2) (< pos 6))
if (text_eq op "case") (eq pos 3)
and (eq pos 1) (or (text_eq op "let") (or (text_eq op "nil") (or (text_eq op "get") (text_eq op "with"))))

display_raw op:t pos:i > b
if (text_eq op "catch") (or (eq pos 1) (eq pos 3))
and (text_eq op "scan") (eq pos 1)

display_call parts:*{Term} > t
let op raw_at parts 0
let text fold parts "(" acc row term
  let raw get raw term
  let value if (and (eq row 3) (text_eq op "list"))
    (let n text_len raw
     let offset fold (indices n) 0 skip pos unused
       if (and (eq skip (- pos 1)) (and (< pos n) (text_eq (text_slice raw skip pos) "0"))) pos skip
     text_slice raw offset n)
    raw
  concat acc (concat (if (eq row 1) "" " ") value)
concat text ")"

operand token:t display:b > {Term}
if display (make Term raw token cpp "" stable false access "") (atom token)

push_part frame:{Pending} term:{Term} > {Pending}
with parts frame (append (get parts frame) term)

lower_child parts:*{Term} parent:*{Term} > t
if (not (and (eq (length parent) 6) (text_eq (raw_at parts 0) "append"))) (lower parts)
if (not (and (text_eq (raw_at parent 0) "fold") (text_eq (raw_at parts 1) (raw_at parent 3)))) (lower parts)
cat3 "([&](){auto item=" (expr_at parts 2)
  (cat3 ";return t_append(std::move(" (expr_at parts 1) "),std::move(item));}())")

close_one reading:{Reader} > {Reader}
let frame get current reading
let previous need (at (get saved reading) (get parent frame)) "bootstrap_unmatched_close" 0
let parts get parts frame
let node if (get display reading) (make Term raw (display_call parts) cpp "" stable false access "")
  (let op raw_at parts 0
   let stable if (or (text_eq op "first") (text_eq op "second")) (get stable (need (at parts 1) "bootstrap_pair" 0))
     (and (text_eq op "get") (get stable (need (at parts 2) "bootstrap_receiver" 0)))
   let indexed and (text_eq op "at") (get stable (need (at parts 1) "bootstrap_sequence" 0))
   let prefix if indexed (cat3 "t_indexed(" (expr_at parts 1) (cat3 "," (expr_at parts 2) ",")) ""
   make Term raw "" cpp (lower_child parts (get parts previous)) stable stable access prefix)
with current reading (push_part previous node)

reduce_frames reading:{Reader} > {Reader}
fold (indices (get depth (get current reading))) reading acc row skip
  let frame get current acc
  if (and (not (get grouped frame)) (and (eq (length (get parts frame)) (get target frame)) (not (< (get parent frame) 0))))
    (close_one acc) acc

bootstrap_arity token:t > ?i
if (text_eq token "bootstrap_pg_send") (some 4)
if (white (cat3 "|" token "|") "|bootstrap_pg_open|bootstrap_pg_step|bootstrap_pg_cols|bootstrap_pg_count|bootstrap_pg_error|") (some 1)
if (white (cat3 "|" token "|") "|bootstrap_pg_oid|bootstrap_pg_name|bootstrap_pg_size|bootstrap_pg_value|") (some 2)
if (text_eq token "bootstrap_replace") (some 2)
if (text_eq token "bootstrap_https") (some 5)
if (text_eq (text_slice token 0 14) "bootstrap_sql_") (sqlite_abi_arity (text_slice token 14 (text_len token)))
if (not (text_eq (text_slice token 0 10) "bootstrap_")) (nil i)
if (white (cat3 "|" token "|") "|bootstrap_candidate|bootstrap_arm|bootstrap_commit|bootstrap_octets_utf8|bootstrap_utf8_octets|bootstrap_character|bootstrap_open_read|") (some 1)
if (or (text_eq token "bootstrap_line") (text_eq token "bootstrap_while")) (some 4)
if (text_eq token "bootstrap_stage") (some 3)
if (white (cat3 "|" token "|") "|bootstrap_install|bootstrap_stage_set|bootstrap_recover|bootstrap_project|bootstrap_code_at|bootstrap_bit_and|bootstrap_bit_xor|bootstrap_rotr32|bootstrap_read_bytes|") (some 2) (nil i)

add_token reading:{Reader} token:t env:{Vocabulary} > {Reader}
let frame get current reading
let parts get parts frame
let pos length parts
let opening get opening reading
if (text_eq token ")")
  (if (or opening (or (not (get grouped frame)) (not (eq pos (get target frame))))) (fail "bootstrap_close_arity")
   (reduce_frames (close_one reading)))
if (not (< pos (get target frame))) fail "bootstrap_extra_operand"
let parent_op case (at parts 0) "" term (get raw term)
let display get display reading
let raw or (raw_position parent_op pos) (and display (display_raw parent_op pos))
if (text_eq token "(")
  (if (or opening raw) (fail "bootstrap_unexpected_group") (with opening reading true))
if raw
  (let target if (and (text_eq parent_op "list") (eq pos 2))
     (+ 3 (need (int token) "bootstrap_count" 0))
     (if (and (text_eq parent_op "make") (eq pos 1))
       (+ 2 (* 2 (need (lookup_size (get types env) (get widths env) token) "bootstrap_record" 0)))
       (if (and (text_eq parent_op "match") (not (text_eq token "end"))) (+ pos 3) (get target frame)))
   if (or (< target (+ pos 1)) (> target 4096)) (fail "bootstrap_arity")
   reduce_frames (with current reading (push_part (with target frame target) (operand token display))))
let private_size if display (nil i) (bootstrap_arity token)
let arity case private_size (if (text_eq token "list") (some 2) (if (text_eq token "make") (some 1)
  (case (intrinsic token) (case (if display (display_arity token) (nil i)) (lookup_size (get names env) (get arities env) token) ar (some ar)) value (some value)))) size (some size)
case arity
  (if opening (fail "bootstrap_group_atom")
   (reduce_frames (with current reading (push_part frame (operand token display)))))
  count
  let parents get saved reading
  let depth + 1 (get depth frame)
  if (> depth 48) fail "bootstrap_depth"
  let child make Pending parts (list {Term} 1 (operand token display)) parent (length parents) target (+ count 1) grouped opening depth depth
  reduce_frames (make Reader current child saved (append parents frame) opening false display display)

parse_expression body:*t env:{Vocabulary} display:b gaps:t > t
let root make Pending parts (list {Term} 0) parent -1 target 1 grouped false depth 0
let start make Reader current root saved (list {Pending} 0) opening false display display
let parsed fold body start cursor row line fold (line_tokens line display gaps) cursor acc idx token add_token acc token env
let frame get current parsed
if (not (and (not (get opening parsed)) (and (eq (get parent frame) -1) (eq (length (get parts frame)) 1)))) fail "bootstrap_missing_operand"
if display (raw_at (get parts frame) 0) (expr_at (get parts frame) 0)

expression body:*t env:{Vocabulary} > t
parse_expression body env false " \t\r"

finish cursor:{Blocks} > {Blocks}
if (text_eq (get head cursor) "") cursor
make Blocks done (append (get done cursor) (make Decl head (get head cursor) body (get body cursor))) head "" body (list t 0)

declarations source:t gaps:t > *{Decl}
let start make Blocks done (list {Decl} 0) head "" body (list t 0)
let size text_len source
let result fold (indices (div (+ size 2047) 2048)) (pair 0 start) prior page unused
  let from first prior
  if (eq from size) prior
  let stop if (> (- size from) 2048)
    (case (text_find source "\n" (+ from 2047)) size newline (+ newline 1)) size
  let blocks fold (lines (text_slice source from stop)) (second prior) cursor row line
    if (blank_source_line line gaps) (finish cursor)
    (if (text_eq (get head cursor) "") (with head cursor line) (with body cursor (append (get body cursor) line)))
  pair stop blocks
get done (finish (second result))

binding text:t parameter:b > t
let split need (text_find text ":" 0) "bootstrap_binding" 0
let typ text_slice text (+ split 1) (text_len text)
let by_ref and parameter (not (or (text_eq typ "i") (text_eq typ "b")))
cat3 (cpp_type typ) (if by_ref " const& " " ") (var_cpp (text_slice text 0 split))

parameter_type sig:*t pos:i > t
let field need (at sig pos) "bootstrap_parameter" 0
let split need (text_find field ":" 0) "bootstrap_binding" 0
text_slice field (+ split 1) (text_len field)

emit_decl output:{Product} decl:{Decl} env:{Vocabulary} target:t > {Product}
let sig tokens (get head decl)
let name need (at sig 0) "bootstrap_header" 0
let body get body decl
if (or (text_eq name "example") (text_eq name "use")) output
if (text_eq name "variant")
  (let name_type identifier (need (at sig 1) "bootstrap_variant" 0)
   let labels fold (record_fields decl " \t\r") "" acc pos label concat acc (concat (var_cpp label) ",")
   with records output (concat (get records output) (cat3 "enum class R_" name_type (cat3 "{" labels "tide_count};\n"))))
if (text_eq name "record")
  (let fields fold (record_fields decl " \t\r") "" acc pos field concat acc (concat (binding field false) ";")
   with records output (concat (get records output)
    (cat3 "struct R_" (identifier (need (at sig 1) "bootstrap_record" 0)) (cat3 "{" fields "};\n"))))
let n length sig
if (not (text_eq (need (at sig (- n 2)) "bootstrap_signature" 0) ">")) fail "bootstrap_signature"
let result cpp_type (need (at sig (- n 1)) "bootstrap_result" 0)
let params fold sig "" acc pos field
  if (or (eq pos 1) (> pos (- n 2))) acc (concat acc (concat (if (eq pos 2) "" ",") (binding field true)))
let head cat3 result " f_" (concat (identifier name) (cat3 "(" params ")"))
let definition cat3 head "{return " (concat (expression body env) ";}\n")
let entry if (not (text_eq name target)) (get entry output)
  (if (not (text_eq (get entry output) "")) (fail "bootstrap_duplicate_entry")
   let fn concat "f_" (identifier name)
   if (eq n 3) (call_cpp fn "")
   (let first_type parameter_type sig 1
    if (not (text_eq first_type "r")) (fail "bootstrap_entry_signature")
    if (eq n 4) (call_cpp fn "input")
    (if (and (eq n 5) (text_eq (parameter_type sig 2) "t"))
       (call_cpp fn "input,entry") (fail "bootstrap_entry_signature"))))
make Product records (get records output) forwards (concat (get forwards output) (concat head ";\n")) functions (concat (get functions output) definition) entry entry

unicode_runtime > t
let rows list t 25
  "Opt<I> t_text_rfind(const Text&s,const Text&n,I end){size_t limit=std::clamp<I>(end,0,s.size());if(n.size()>limit)return {};auto i=s.rfind(n,limit-n.size());if(i==Text::npos)return {};return I(i);}"
  "static_assert(sizeof(wchar_t)==sizeof(char32_t));"
  "size_t transcode(const char* from,const char* to,const char* source,size_t input_size,char* out,size_t capacity){"
  "  iconv_t codec=iconv_open(to,from);if(codec==(iconv_t)-1)throw std::runtime_error(\"E_ENCODING\");"
  "  char* in=const_cast<char*>(source);size_t left=capacity;"
  "  bool ok=iconv(codec,&in,&input_size,&out,&left)!=(size_t)-1;iconv_close(codec);"
  "  if(!ok||input_size)throw std::range_error(\"E_UTF8\");return capacity-left;"
  "}"
  "Text decode(const std::string& bytes){"
  "  Text value(bytes.size(),0);size_t n=transcode(\"UTF-8\",\"WCHAR_T\",bytes.data(),bytes.size(),reinterpret_cast<char*>(value.data()),value.size()*sizeof(char32_t));"
  "  value.resize(n/sizeof(char32_t));"
  "  if(std::any_of(value.begin(),value.end(),[](char32_t c){return c>0x10ffff||(c>=0xd800&&c<=0xdfff);}))throw std::range_error(\"E_UTF8\");"
  "  return value;"
  "}"
  "std::string encode(const Text& value){"
  "  std::string bytes(value.size()*4,0);size_t n=transcode(\"WCHAR_T\",\"UTF-8\",reinterpret_cast<const char*>(value.data()),value.size()*sizeof(char32_t),bytes.data(),bytes.size());"
  "  bytes.resize(n);return bytes;"
  "}"
  "template<size_t N> struct LiteralText {"
  "  char32_t units[N];"
  "  constexpr LiteralText(const char32_t (&s)[N]){std::copy_n(s,N,units);}"
  "};"
  "template<LiteralText S> const Text& literal(){static const Text value(S.units,std::size(S.units)-1);return value;}"
  "std::ostream& operator<<(std::ostream& os,const Text& s){return os<<encode(s);}"
