let rows list t 77
  "#include <cstring>"
  "struct InputFD {"
  "    int fd;"
  "    explicit InputFD(int value):fd(value){}"
  "    ~InputFD(){if(fd>=0)close(fd);}"
  "    InputFD(const InputFD&)=delete;"
  "};"
  project_io_abi
  "struct SourcePath {"
  "    std::string folder,name;"
  "    explicit SourcePath(const std::string& path){"
  "        auto cut=path.rfind('/');"
  "        folder=cut==path.npos?\".\":cut==0?\"/\":path.substr(0,cut);"
  "        name=cut==path.npos?path:path.substr(cut+1);"
  "    }"
  "    std::string sibling(const std::string& key) const{return (folder==\"/\"?folder:folder+\"/\")+key;}"
  "};"
  "template<class Error>"
  "std::pair<Text,I> read_unit_at(int dir,const std::string& name,bool nofollow,Error error){"
  "    InputFD input(openat(dir,name.c_str(),O_RDONLY|O_NONBLOCK|O_CLOEXEC|(nofollow?O_NOFOLLOW:0)));"
  "    if(input.fd<0)throw error(errno);"
  "    struct stat st;if(fstat(input.fd,&st))throw error(errno);"
  "    if(!S_ISREG(st.st_mode))throw Failure{\"regular_file_required\",0};"
  "    char block[8192];std::string bytes;"
  "    for(;;){"
  "        auto n=read(input.fd,block,sizeof block);if(n<0&&errno==EINTR)continue;"
  "        if(n<0)throw error(errno);"
  "        if(!n)break;"
  "        if(bytes.size()+size_t(n)>131072)throw Failure{\"input_limit\",0};"
  "        bytes.append(block,n);"
  "    }"
  "    return {decode(bytes),I(bytes.size())};"
  "}"
  "template<class Error>"
  "std::pair<Text,I> read_import_at(int dir,const std::string& name,Error error){"
  "    std::unique_ptr<InputFD> owned;"
  "    size_t start=0;"
  "    for(;;){"
  "        auto cut=name.find('/',start);"
  "        std::string part=name.substr(start,cut==name.npos?name.npos:cut-start);"
  "        if(part.empty()||part==\".\"||part==\"..\")throw Failure{\"invalid_sibling_request\",0};"
  "        if(cut==name.npos)return read_unit_at(dir,part,true,error);"
  "        auto next=std::make_unique<InputFD>(openat(dir,part.c_str(),O_PATH|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC));"
  "        if(next->fd<0)throw error(errno);"
  "        dir=next->fd;owned=std::move(next);"
  "        start=cut+1;"
  "    }"
  "}"
  "template<class Begin,class Supply,class Escape,class Report>"
  "auto load_project(int dir,const SourcePath& path,const Text& entry,const std::pair<Text,I>* overlay,const Text& unit,Begin begin,Supply supply,Escape escape,Report report){"
  "    auto load=[&](const std::string& name,bool sibling){"
  "        auto error=[&](int code){return Failure{report(entry,decode(path.sibling(name)),code,decode(strerror(code))),0};};return sibling?read_import_at(dir,name,error):read_unit_at(dir,name,false,error);"
  "    };"
  "    auto wire=[&](const Text& s){Text out;if(entry.empty()||(entry[0]!=':'&&entry[0]!='#'))return out;"
  "        out.reserve(s.size()+2);out+=U'\"';"
  "        for(char32_t c:s){if(c>=32&&c<127&&c!='\"'&&c!=92)out+=c;else out+=escape(I(c));}"
  "        out+=U'\"';return out;};"
  "    auto root=(overlay&&unit==decode(path.name))?*overlay:load(path.name.empty()?\".\":path.name,false);"
  "    auto state=begin(root.first,wire(root.first),root.second,decode(path.name),entry);"
  "    for(unsigned i=0;!state.v_next_name.empty();++i){"
  "        const auto& key=state.v_next_name;"
  "        if(i>=64||key.find(char32_t(0))!=Text::npos)throw Failure{\"invalid_sibling_request\",0};"
  "        auto data=overlay&&key==unit?*overlay:load(encode(key),true);"
  "        state=supply(state,data.first,wire(data.first),data.second);"
  "    }"
  "    return state;"
  "}"
  "template<class Begin,class Supply,class Finish,class Escape,class Report>"
  "Text read_siblings(const std::string& path,const Text& entry,const Text& call,const Text& inputs,Begin begin,Supply supply,Finish finish,Escape escape,Report report){"
  "    SourcePath location(path);InputFD dir(open(location.folder.c_str(),O_PATH|O_DIRECTORY|O_CLOEXEC));"
  "    if(dir.fd<0){int code=errno;throw Failure{report(entry,decode(path),code,decode(strerror(code))),0};}"
  "    auto snapshot=[&](){try{"
  "        project_io::ProjectDirectory project(location.folder);project_io::acquire(project,false);"
  "        return load_project(dir.fd,location,entry,nullptr,Text{},begin,supply,escape,report);"
  "    }catch(const std::system_error& e){throw Failure{report(entry,decode(location.folder),e.code().value(),decode(strerror(e.code().value()))),0};}}();"
  "    return finish(snapshot,entry,call,inputs);"
  "}"
