service_abi > t
let rows list t 115
  "#include <cstring>"
  "#include <microhttpd.h>"
  "#include <arpa/inet.h>"
  "#include <signal.h>"
  "#include <functional>"
  "#include <condition_variable>"
  "#include <list>"
  "#include <thread>"
  "#include <mutex>"
  "using ServiceOutput=std::pair<I,std::pair<Seq<Text>,Text>>;"
  "using ServiceHandler=std::function<ServiceOutput(const Text&,const Text&,const Text&,const Text&)>;"
  "struct ServiceRequest{"
  "    Text method,path,headers,body;bool large=false;MHD_Connection* conn=nullptr;int fd=-1;"
  "    std::atomic_bool done{false};ServiceOutput reply{503,{{},U\"Request cancelled\"}};"
  "    void resume(){auto connection=conn;done.store(true,std::memory_order_release);MHD_resume_connection(connection);}"
  "};"
  "struct ServicePool{"
  "    ServiceHandler handler;size_t workers,limit;std::mutex mutex;std::condition_variable changed;"
  "    std::list<ServiceRequest*> ready,waiting;std::vector<std::thread> threads;"
  "    size_t active=0,peak_active=0,peak_waiting=0,rejected=0,queued_aborts=0,active_aborts=0;"
  "    void prune_locked(){"
  "        for(auto i=waiting.begin();i!=waiting.end();){"
  "            auto req=*i;"
  "            if(!tide_stop.load()&&!service_peer_closed(req->fd)){++i;continue;}"
  "            i=waiting.erase(i);++queued_aborts;req->resume();"
  "        }"
  "    }"
  "    bool admit(ServiceRequest& req){"
  "        std::lock_guard<std::mutex> lock(mutex);"
  "        if(tide_stop.load())return false;"
  "        prune_locked();"
  "        auto decision=f_service_admission(workers,limit,active,waiting.size());"
  "        if(decision==U\"full\"){++rejected;return false;}"
  "        bool run=decision==U\"run\";(run?ready:waiting).push_back(&req);"
  "        MHD_suspend_connection(req.conn);"
  "        if(run){++active;peak_active=std::max(peak_active,active);changed.notify_one();}"
  "        else peak_waiting=std::max(peak_waiting,waiting.size());"
  "        return true;"
  "    }"
  "    void work(){"
  "        std::unique_lock<std::mutex> lock(mutex);"
  "        for(;;){"
  "            changed.wait(lock,[&]{return tide_stop.load()||!ready.empty();});"
  "            if(ready.empty())return;"
  "            auto req=ready.front();ready.pop_front();lock.unlock();"
  "            tide_peer=ServicePeer{req->fd};"
  "            try{if(!tide_service_cancelled())req->reply=handler(req->method,req->path,req->headers,req->body);}"
  "            catch(...){req->reply.first=tide_service_cancelled()?503:500;req->reply.second.second=U\"Request failed\";}"
  "            bool aborted=tide_service_cancelled();tide_peer=ServicePeer{};"
  "            lock.lock();if(aborted)++active_aborts;req->resume();prune_locked();"
  "            if(waiting.empty()){--active;continue;}"
  "            ready.splice(ready.end(),waiting,waiting.begin());changed.notify_one();"
  "        }"
  "    }"
  "    void shutdown(){"
  "        {std::lock_guard<std::mutex> lock(mutex);tide_stop.store(true);prune_locked();}"
  "        changed.notify_all();for(auto& t:threads)if(t.joinable())t.join();"
  "    }"
  "    ~ServicePool(){shutdown();}"
  "};"
  "struct ServiceHeaders{Text raw;bool large=false;};"
  "MHD_Result service_header(void* ctx,MHD_ValueKind,const char* key,const char* value){"
  "    auto& h=*static_cast<ServiceHeaders*>(ctx);if(!key||!value)return MHD_YES;"
  "    size_t k=strlen(key),v=strlen(value);if(k>128||v>4096||k+v+h.raw.size()>32768){h.large=true;return MHD_NO;}"
  "    for(size_t i=0;i<k;++i)h.raw+=static_cast<unsigned char>(key[i]);h.raw+=U\": \";"
  "    for(size_t i=0;i<v;++i)h.raw+=static_cast<unsigned char>(value[i]);h.raw+=U'\\n';return MHD_YES;"
  "}"
  "MHD_Result service_send(MHD_Connection* conn,unsigned code,const Text& body,const Seq<Text>& headers={}){"
  "    std::string bytes(body.begin(),body.end());"
  "    auto raw=MHD_create_response_from_buffer(bytes.size(),bytes.data(),MHD_RESPMEM_MUST_COPY);if(!raw)return MHD_NO;"
  "    std::unique_ptr<MHD_Response,decltype(&MHD_destroy_response)> response(raw,MHD_destroy_response);"
  "    for(const auto& header:headers){auto h=encode(header);auto cut=h.find(':');bool empty=cut==std::string::npos;if(empty)cut=h.size()-1;"
  "        if(MHD_add_response_header(raw,h.substr(0,cut).c_str(),empty?\"\":h.substr(cut+2).c_str())!=MHD_YES)return MHD_NO;}"
  "    return MHD_queue_response(conn,code,raw);"
  "}"
  "MHD_Result service_access(void* ctx,MHD_Connection* conn,const char* path,const char* method,const char*,const char* upload,size_t* count,void** slot){"
  "    try{if(!*slot){*slot=new ServiceRequest{};return MHD_YES;}"
  "        auto& req=*static_cast<ServiceRequest*>(*slot);"
  "        if(req.done.load(std::memory_order_acquire))return service_send(conn,unsigned(req.reply.first),req.reply.second.second,req.reply.second.first);"
  "        if(*count){if(*count>131072-req.body.size())req.large=true;"
  "            if(!req.large)for(size_t i=0;i<*count;++i)req.body+=static_cast<unsigned char>(upload[i]);*count=0;return MHD_YES;}"
  "        if(req.large)return service_send(conn,413,U\"Payload too large\");"
  "        ServiceHeaders headers;MHD_get_connection_values(conn,MHD_HEADER_KIND,service_header,&headers);"
  "        if(headers.large)return service_send(conn,431,U\"Headers too large\");"
  "        auto& pool=*static_cast<ServicePool*>(ctx);auto info=MHD_get_connection_info(conn,MHD_CONNECTION_INFO_CONNECTION_FD);"
  "        if(!info)return MHD_NO;req.conn=conn;req.fd=info->connect_fd;"
  "        req.method=decode(method);req.path=decode(path);req.headers=std::move(headers.raw);"
  "        if(pool.admit(req))return MHD_YES;"
  "        if(tide_stop.load())return service_send(conn,503,U\"Service stopping\");"
  "        return service_send(conn,503,U\"{\\\"error\\\":\\\"queue_full\\\"}\",{U\"Content-Type: application/json\",U\"Retry-After: 1\"});"
  "    }catch(...){try{return service_send(conn,tide_service_cancelled()?503:500,U\"Request failed\");}catch(...){return MHD_NO;}}"
  "}"
  "void service_completed(void*,MHD_Connection*,void** slot,MHD_RequestTerminationCode){delete static_cast<ServiceRequest*>(*slot);*slot=nullptr;}"
  "Text tide_serve(const R_ServiceOptions& opts,ServiceHandler handler){"
  "    sockaddr_in addr{};addr.sin_family=AF_INET;addr.sin_port=htons(uint16_t(opts.v_port));"
  "    if(inet_pton(AF_INET,encode(opts.v_address).c_str(),&addr.sin_addr)!=1)throw Failure{\"Expected a numeric IPv4 listen address\",0};"
  "    sigset_t signals;sigemptyset(&signals);sigaddset(&signals,SIGTERM);sigaddset(&signals,SIGINT);"
  "    if(pthread_sigmask(SIG_BLOCK,&signals,nullptr))throw Failure{\"Cannot configure shutdown\",0};"
  "    ServicePool pool{std::move(handler),size_t(opts.v_workers),size_t(opts.v_queue)};"
  "    for(size_t i=0;i<pool.workers;++i)pool.threads.emplace_back([&]{pool.work();});"
  "    auto server=MHD_start_daemon(MHD_USE_ERROR_LOG|MHD_USE_POLL_INTERNAL_THREAD|MHD_ALLOW_SUSPEND_RESUME,0,nullptr,nullptr,service_access,&pool,"
  "        MHD_OPTION_SOCK_ADDR,reinterpret_cast<sockaddr*>(&addr),MHD_OPTION_CONNECTION_TIMEOUT,10U,MHD_OPTION_CONNECTION_LIMIT,128U,"
  "        MHD_OPTION_NOTIFY_COMPLETED,service_completed,nullptr,MHD_OPTION_END);"
  "    if(!server)throw Failure{\"Cannot open granted HTTP listener\",0};"
  "    const auto* info=MHD_get_daemon_info(server,MHD_DAEMON_INFO_BIND_PORT);"
  "    std::cerr<<\"LISTEN \"<<encode(opts.v_address)<<\":\"<<info->port<<\"\\n\"<<std::flush;"
  "    timespec tick{0,25000000};int caught;"
  "    while((caught=sigtimedwait(&signals,nullptr,&tick))<0 && (errno==EAGAIN||errno==EINTR)){"
  "        std::lock_guard<std::mutex> lock(pool.mutex);pool.prune_locked();"
  "    }"
  "    pool.shutdown();MHD_stop_daemon(server);"
  "    std::cerr<<\"SERVICE peak_active=\"<<pool.peak_active<<\" peak_queued=\"<<pool.peak_waiting<<\" rejected=\"<<pool.rejected"
  "             <<\" queued_aborts=\"<<pool.queued_aborts<<\" active_aborts=\"<<pool.active_aborts<<\"\\n\";"
  "    if(caught<0)throw Failure{\"Failed waiting for shutdown\",0};return {};"
  "}"
fold rows "" code row line concat code (concat line "\n")
