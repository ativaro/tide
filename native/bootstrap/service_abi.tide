let rows list t 50
  "#include <cstring>"
  "#include <microhttpd.h>"
  "#include <arpa/inet.h>"
  "#include <signal.h>"
  "#include <functional>"
  "using ServiceOutput=std::pair<I,std::pair<Seq<Text>,Text>>;"
  "using ServiceHandler=std::function<ServiceOutput(const Text&,const Text&,const Text&,const Text&)>;"
  "struct ServiceRequest{Text body;bool large=false;};"
  "struct ServiceHeaders{Text raw;bool large=false;};"
  "MHD_Result service_header(void* ctx,MHD_ValueKind,const char* key,const char* value){"
  "    auto& h=*static_cast<ServiceHeaders*>(ctx);if(!key||!value)return MHD_YES;"
  "    size_t k=strlen(key),v=strlen(value);if(k>128||v>4096||k+v+h.raw.size()>32768){h.large=true;return MHD_NO;}"
  "    for(size_t i=0;i<k;++i)h.raw+=static_cast<unsigned char>(key[i]);h.raw+=U\": \";"
  "    for(size_t i=0;i<v;++i)h.raw+=static_cast<unsigned char>(value[i]);h.raw+=U'\\n';return MHD_YES;"
  "}"
  "MHD_Result service_send(MHD_Connection* conn,unsigned code,const Text& body,const Seq<Text>& headers={}){"
  "    std::string bytes(body.begin(),body.end());"
  "    auto raw=MHD_create_response_from_buffer(bytes.size(),bytes.data(),MHD_RESPMEM_MUST_COPY);if(!raw)return MHD_NO;"
  "    std::unique_ptr<MHD_Response,decltype(&MHD_destroy_response)> response(raw,MHD_destroy_response);"
  "    for(const auto& header:headers){auto h=encode(header);auto cut=h.find(':');bool empty=cut==std::string::npos;if(empty)cut=h.size()-1;"
  "        if(MHD_add_response_header(raw,h.substr(0,cut).c_str(),empty?\"\":h.substr(cut+2).c_str())!=MHD_YES)return MHD_NO;}"
  "    return MHD_queue_response(conn,code,raw);"
  "}"
  "MHD_Result service_access(void* ctx,MHD_Connection* conn,const char* path,const char* method,const char*,const char* upload,size_t* count,void** slot){"
  "    try{if(!*slot){*slot=new ServiceRequest{};return MHD_YES;}"
  "        auto& req=*static_cast<ServiceRequest*>(*slot);"
  "        if(*count){if(*count>131072-req.body.size())req.large=true;"
  "            if(!req.large)for(size_t i=0;i<*count;++i)req.body+=static_cast<unsigned char>(upload[i]);*count=0;return MHD_YES;}"
  "        if(req.large)return service_send(conn,413,U\"Payload too large\");"
  "        ServiceHeaders headers;MHD_get_connection_values(conn,MHD_HEADER_KIND,service_header,&headers);"
  "        if(headers.large)return service_send(conn,431,U\"Headers too large\");"
  "        const auto& fn=*static_cast<ServiceHandler*>(ctx);auto reply=fn(decode(method),decode(path),headers.raw,req.body);"
  "        return service_send(conn,unsigned(reply.first),reply.second.second,reply.second.first);"
  "    }catch(...){try{return service_send(conn,tide_service_cancelled()?503:500,U\"Request failed\");}catch(...){return MHD_NO;}}"
  "}"
  "void service_completed(void*,MHD_Connection*,void** slot,MHD_RequestTerminationCode){delete static_cast<ServiceRequest*>(*slot);*slot=nullptr;}"
  "Text tide_serve(const R_ServiceOptions& opts,ServiceHandler handler){"
  "    sockaddr_in addr{};addr.sin_family=AF_INET;addr.sin_port=htons(uint16_t(opts.v_port));"
  "    if(inet_pton(AF_INET,encode(opts.v_address).c_str(),&addr.sin_addr)!=1)throw Failure{\"Expected a numeric IPv4 listen address\",0};"
  "    sigset_t signals;sigemptyset(&signals);sigaddset(&signals,SIGTERM);sigaddset(&signals,SIGINT);"
  "    if(pthread_sigmask(SIG_BLOCK,&signals,nullptr))throw Failure{\"Cannot configure shutdown\",0};"
  "    auto server=MHD_start_daemon(MHD_USE_INTERNAL_POLLING_THREAD|MHD_USE_ITC,0,nullptr,nullptr,service_access,&handler,"
  "        MHD_OPTION_SOCK_ADDR,reinterpret_cast<sockaddr*>(&addr),MHD_OPTION_CONNECTION_TIMEOUT,10U,MHD_OPTION_CONNECTION_LIMIT,128U,"
  "        MHD_OPTION_THREAD_POOL_SIZE,unsigned(opts.v_workers),MHD_OPTION_NOTIFY_COMPLETED,service_completed,nullptr,MHD_OPTION_END);"
  "    if(!server)throw Failure{\"Cannot open granted HTTP listener\",0};"
  "    const auto* info=MHD_get_daemon_info(server,MHD_DAEMON_INFO_BIND_PORT);"
  "    std::cerr<<\"LISTEN \"<<encode(opts.v_address)<<\":\"<<info->port<<\"\\n\"<<std::flush;"
  "    int caught;int err=sigwait(&signals,&caught);tide_stop.store(true,std::memory_order_relaxed);MHD_stop_daemon(server);"
  "    if(err)throw Failure{\"Failed waiting for shutdown\",0};return {};"
  "}"
fold rows "" code row line concat code (concat line "\n")
