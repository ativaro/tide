use editor

use node_edits

apply_edit grant:{ProjectGrant} entry:t raw:?t base:t allow:b write:b > t
let file text_slice entry 1 (text_len entry)
let edits case raw (nil {EditPayload}) text (some (read_edit_json (if (text_eq text "") "null" text) file))
let original bootstrap_project grant (nil &tt)
let before edit_base original base
if (case edits false payload (get mixed payload))
  (if write fail (root_diagnostic file "E_EDIT" "Preview multi-file edits and apply the checked files in a project copy")
   let payload need edits "missing_edit_payload" 0
   let preview multi_edit_preview original before payload file
   let checked checked_edit_fields (get declarations before) (get project preview) base allow ""
   cat3 checked ",\"written\":false,\"files\":[" (concat (get files preview) "]}\n"))
let unit case edits (need (at (get units original) 0) "missing_root" 0) payload (edit_target original payload file)
if (and write (case (text_find (get name unit) "/" 0) false found true))
  fail (root_diagnostic file "E_EDIT" "Write the package in its own checkout or preview the edit")
let source case edits (bootstrap_candidate grant) payload (edited_source original before unit (get edits payload) file)
let overlay some (pair (get name unit) source)
let candidate bootstrap_project grant overlay
let result edit_candidate (get declarations before) candidate (get name unit) base allow write
if (not write) result
let staged bootstrap_stage grant unit source
let unchanged text_eq (project_snapshot original) (project_snapshot (bootstrap_project grant (nil &tt)))
let consistent and unchanged (text_eq (project_snapshot candidate) (project_snapshot (bootstrap_project grant overlay)))
if (not consistent) fail (root_diagnostic file "E_REVISION" "Source changed during edit")
if (bootstrap_commit staged) result (fail "commit_failed")
