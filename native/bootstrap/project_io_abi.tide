project_io_abi > t
let rows list t 164
  "#include <sys/file.h>"
  "#include <sys/syscall.h>"
  "#include <dirent.h>"
  "#include <filesystem>"
  "#include <system_error>"
  ""
  "namespace project_io {"
  "namespace fs = std::filesystem;"
  "constexpr char journal[] = \".tide-edit-transaction-v1\";"
  ""
  "void check(int result){"
  "    if(result<0)throw std::system_error(errno,std::generic_category());"
  "}"
  "void sync_dir(int fd){check(fsync(fd));}"
  "void lock(int fd,int mode){"
  "    while(flock(fd,mode)<0){if(errno!=EINTR)check(-1);}"
  "}"
  "bool exists(int dir,const std::string& name){"
  "    struct stat st;"
  "    if(fstatat(dir,name.c_str(),&st,AT_SYMLINK_NOFOLLOW)==0)return true;"
  "    if(errno==ENOENT)return false;"
  "    check(-1);return false;"
  "}"
  "struct Target {"
  "    InputFD parent;"
  "    std::string name;"
  "    Target(int root,const std::string& path):parent(dup(root)){"
  "        check(parent.fd);"
  "        size_t start=0;"
  "        for(;;){"
  "            auto cut=path.find('/',start);"
  "            name=path.substr(start,cut==path.npos?path.npos:cut-start);"
  "            if(name.empty()||name==\".\"||name==\"..\"||name==journal||name.find(char(0))!=name.npos)"
  "                throw std::system_error(EINVAL,std::generic_category());"
  "            if(cut==path.npos)break;"
  "            int sub=openat(parent.fd,name.c_str(),O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);"
  "            check(sub);close(parent.fd);parent.fd=sub;start=cut+1;"
  "        }"
  "    }"
  "};"
  "struct stat info(int dir,const std::string& name){"
  "    struct stat st;check(fstatat(dir,name.c_str(),&st,AT_SYMLINK_NOFOLLOW));"
  "    if(!S_ISREG(st.st_mode))throw std::system_error(EINVAL,std::generic_category());"
  "    return st;"
  "}"
  "bool same(const struct stat& a,const struct stat& b){return a.st_dev==b.st_dev&&a.st_ino==b.st_ino;}"
  "void exchange(int a,const std::string& x,int b,const std::string& y){"
  "    check(syscall(SYS_renameat2,a,x.c_str(),b,y.c_str(),RENAME_EXCHANGE));"
  "}"
  ""
  "struct ProjectDirectory {"
  "    fs::path root;"
  "    std::string prefix;"
  "    InputFD fd;"
  "    explicit ProjectDirectory(const std::string& folder):root(fs::canonical(folder)),fd(-1){"
  "        auto entry=root;"
  "        // A package opened directly participates in the lock of its importing project."
  "        while(root.parent_path().parent_path().filename()==\"vendor\"){"
  "            auto v=root.filename().string();"
  "            if(std::count(v.begin(),v.end(),'.')!=2||v.find_first_not_of(\"0123456789.\")!=v.npos)break;"
  "            root=root.parent_path().parent_path().parent_path();"
  "        }"
  "        if(entry!=root)prefix=entry.lexically_relative(root).string()+\"/\";"
  "        fd.fd=open(root.c_str(),O_RDONLY|O_DIRECTORY|O_CLOEXEC);check(fd.fd);"
  "    }"
  "};"
  ""
  "struct Journal {"
  "    int root;"
  "    InputFD dir;"
  "    explicit Journal(int parent):root(parent),dir(openat(parent,journal,O_DIRECTORY|O_RDONLY|O_NOFOLLOW|O_CLOEXEC)){"
  "        check(dir.fd);"
  "        struct stat st;check(fstat(dir.fd,&st));"
  "        if(st.st_uid!=geteuid()||(st.st_mode&0777)!=0700)"
  "            throw std::system_error(EACCES,std::generic_category());"
  "    }"
  "    std::string link_text(const std::string& name){"
  "        char buf[4096];auto len=readlinkat(dir.fd,name.c_str(),buf,sizeof buf);"
  "        check(len);if(len==sizeof buf)throw std::system_error(ENAMETOOLONG,std::generic_category());"
  "        return {buf,size_t(len)};"
  "    }"
  "    std::string path(const std::string& n){return link_text(\"path.\"+n);}"
  "    std::string identity(){"
  "        struct stat st;check(fstat(root,&st));"
  "        return std::to_string(st.st_dev)+\":\"+std::to_string(st.st_ino)+\":\";"
  "    }"
  "    void stage(size_t i,const std::string& relative,const Text& source){"
  "        auto n=std::to_string(i);Target target(root,relative);"
  "        auto mode=info(target.parent.fd,target.name).st_mode;"
  "        check(symlinkat(relative.c_str(),dir.fd,(\"path.\"+n).c_str()));"
  "        auto swap=\"swap.\"+n;"
  "        InputFD out(openat(dir.fd,swap.c_str(),O_CREAT|O_EXCL|O_WRONLY|O_CLOEXEC,0600));check(out.fd);"
  "        auto bytes=encode(source);"
  "        for(size_t pos=0;pos<bytes.size();){"
  "            auto count=write(out.fd,bytes.data()+pos,bytes.size()-pos);"
  "            if(count<0&&errno==EINTR)continue;"
  "            if(count==0)throw std::system_error(EIO,std::generic_category());"
  "            check(count);pos+=size_t(count);"
  "        }"
  "        check(fchmod(out.fd,mode&07777));sync_dir(out.fd);"
  "        int fd=out.fd;out.fd=-1;check(close(fd));"
  "        check(linkat(dir.fd,swap.c_str(),dir.fd,(\"new.\"+n).c_str(),0));"
  "    }"
  "    void move(size_t i,bool undo){"
  "        auto n=std::to_string(i),swap=\"swap.\"+n;"
  "        Target target(root,path(n));"
  "        auto fresh=info(dir.fd,\"new.\"+n);"
  "        bool staged=same(info(dir.fd,swap),fresh);"
  "        if(undo&&staged){"
  "            // An interrupted rollback may still need its directory sync."
  "            sync_dir(target.parent.fd);return;"
  "        }"
  "        auto current=info(target.parent.fd,target.name);"
  "        if(undo&&!same(current,fresh))throw std::system_error(ESTALE,std::generic_category());"
  "        exchange(dir.fd,swap,target.parent.fd,target.name);"
  "        sync_dir(target.parent.fd);"
  "        sync_dir(dir.fd);"
  "    }"
  "    void clear(){"
  "        // Only remove the reserved entries. Never follow a path link during cleanup."
  "        InputFD listing(openat(dir.fd,\".\",O_RDONLY|O_DIRECTORY|O_CLOEXEC));check(listing.fd);"
  "        DIR* raw=fdopendir(listing.fd);if(!raw)check(-1);listing.fd=-1;"
  "        std::unique_ptr<DIR,int(*)(DIR*)> stream(raw,closedir);"
  "        std::vector<std::string> files;"
  "        for(;;){"
  "            errno=0;auto ent=readdir(raw);if(!ent){if(errno)check(-1);break;}"
  "            std::string s=ent->d_name;if(s==\".\"||s==\"..\")continue;"
  "            auto dot=s.find('.');"
  "            if(dot==s.npos||(s.substr(0,dot)!=\"path\"&&s.substr(0,dot)!=\"swap\"&&s.substr(0,dot)!=\"new\")||"
  "               s.size()==dot+1||s.size()>dot+3||s.find_first_not_of(\"0123456789\",dot+1)!=s.npos)"
  "                throw std::system_error(EINVAL,std::generic_category());"
  "            files.push_back(s);"
  "        }"
  "        for(auto& s:files)check(unlinkat(dir.fd,s.c_str(),0));"
  "        check(unlinkat(root,journal,AT_REMOVEDIR));sync_dir(root);"
  "    }"
  "    void recover(){"
  "        if(exists(dir.fd,\"undo\")){"
  "            auto marker=link_text(\"undo\"),prefix=identity();"
  "            unsigned count=0;auto end=marker.data()+marker.size();"
  "            if(!marker.starts_with(prefix))throw std::system_error(ESTALE,std::generic_category());"
  "            auto parsed=std::from_chars(marker.data()+prefix.size(),end,count);"
  "            if(parsed.ec!=std::errc{}||parsed.ptr!=end||count==0||count>65)throw std::system_error(EINVAL,std::generic_category());"
  "            for(unsigned i=0;i<count;++i)move(i,true);"
  "            check(unlinkat(dir.fd,\"undo\",0));sync_dir(dir.fd);"
  "        }"
  "        clear();"
  "    }"
  "    void arm(size_t count){"
  "        sync_dir(dir.fd);sync_dir(root);"
  "        check(symlinkat((identity()+std::to_string(count)).c_str(),dir.fd,\"undo\"));sync_dir(dir.fd);"
  "    }"
  "    void finish(){"
  "        check(unlinkat(dir.fd,\"undo\",0));sync_dir(dir.fd);"
  "        clear();"
  "    }"
  "};"
  "void acquire(ProjectDirectory& p,bool writer){"
  "    lock(p.fd.fd,writer?LOCK_EX:LOCK_SH);"
  "    if(!exists(p.fd.fd,journal))return;"
  "    if(!writer){lock(p.fd.fd,LOCK_UN);lock(p.fd.fd,LOCK_EX);}"
  "    if(exists(p.fd.fd,journal))Journal(p.fd.fd).recover();"
  "}"
  "}"
fold rows "" code row line concat code (concat line "\n")

project_stage_abi > t
let rows list t 50
  "struct BatchStage {"
  "    const R_ProjectGrant& io;"
  "    project_io::Journal files;"
  "    size_t count=0;"
  "    bool cleanup=true;"
  "    explicit BatchStage(const R_ProjectGrant& grant):io(grant),files(io.project.fd.fd){}"
  "    ~BatchStage(){"
  "        if(cleanup)try{files.recover();}catch(...){ /* Keep the undo record for the next opener. */ }"
  "    }"
  "};"
  "std::unique_ptr<BatchStage> t_bootstrap_stage_set(const R_ProjectGrant& io,const Seq<R_SourceUnit>& units){"
  "    if(!io.writable)throw io.error(io.target.folder,EACCES);"
  "    const auto root=io.project.fd.fd;"
  "    if(auto pins=read_package_lock(io.project,false))for(const auto& unit:units){"
  "        auto key=io.project.prefix+encode(unit.v_name);"
  "        if(key.starts_with(\"vendor/\"))f_verify_package_source(*pins,decode(key),unit.v_source);"
  "    }"
  "    // This CLI is single-threaded. Keep the recovery directory accessible even under a restrictive umask."
  "    auto mask=umask(0077);"
  "    int created=mkdirat(root,project_io::journal,0700),code=errno;"
  "    umask(mask);"
  "    if(created<0)throw io.error(io.target.folder,code);"
  "    try{"
  "        auto batch=std::make_unique<BatchStage>(io);"
  "        batch->count=units.size();"
  "        size_t i=0;"
  "        for(auto& unit:units){"
  "            auto relative=encode(unit.v_name);"
  "            try{batch->files.stage(i++,io.project.prefix+relative,unit.v_source);}"
  "            catch(const std::system_error& e){throw io.error(io.target.sibling(relative),e.code().value());}"
  "        }"
  "        return batch;"
  "    }catch(const std::system_error& e){throw io.error(io.target.folder,e.code().value());}"
  "}"
  "using BatchHandle=std::unique_ptr<BatchStage>;"
  "bool t_bootstrap_arm(const BatchHandle& batch){"
  "    try{batch->files.arm(batch->count);return true;}"
  "    catch(const std::system_error& e){throw batch->io.error(batch->io.target.folder,e.code().value());}"
  "}"
  "bool t_bootstrap_install(const BatchHandle& batch,I index){"
  "    auto where=batch->io.target.folder;"
  "    try{"
  "        where=(batch->io.project.root/batch->files.path(std::to_string(index))).string();"
  "        batch->files.move(size_t(index),false);return true;"
  "    }catch(const std::system_error& e){throw batch->io.error(where,e.code().value());}"
  "}"
  "bool t_bootstrap_commit(const BatchHandle& batch){"
  "    try{batch->files.finish();batch->cleanup=false;return true;}"
  "    catch(const std::system_error& e){throw batch->io.error(batch->io.target.folder,e.code().value());}"
  "}"
fold rows "" code row line concat code (concat line "\n")

package_install_abi > t
let rows list t 63
  "#include <sys/random.h>"
  "int package_dir(int parent,const std::string& name){"
  "    if(mkdirat(parent,name.c_str(),0755)<0 && errno!=EEXIST)throw package_io_error(name,errno);"
  "    int fd=openat(parent,name.c_str(),O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW);"
  "    if(fd<0)throw package_io_error(name,errno);"
  "    return fd;"
  "}"
  "void publish_package_source(int root,const std::string& path,const Text& contents){"
  "    InputFD dir(dup(root));project_io::check(dir.fd);"
  "    size_t start=0,cut;"
  "    while((cut=path.find('/',start))!=path.npos){"
  "        int next=package_dir(dir.fd,path.substr(start,cut-start));"
  "        project_io::sync_dir(dir.fd);close(dir.fd);dir.fd=next;start=cut+1;"
  "    }"
  "    auto name=path.substr(start);"
  "    uint64_t nonce;std::string temp;int fd;"
  "    do{"
  "        ssize_t n;do{n=getrandom(&nonce,sizeof nonce,0);}while(n<0&&errno==EINTR);"
  "        if(n!=sizeof nonce)throw package_io_error(path,n<0?errno:EIO);"
  "        temp=\".tide-package-\"+std::to_string(nonce);"
  "        fd=openat(dir.fd,temp.c_str(),O_CREAT|O_EXCL|O_NOFOLLOW|O_WRONLY|O_CLOEXEC,0644);"
  "    }while(fd<0&&errno==EEXIST);"
  "    if(fd<0)throw package_io_error(path,errno);"
  "    InputFD dest(fd);"
  "    try{"
  "        auto bytes=encode(contents);"
  "        for(size_t done=0;done<bytes.size();){"
  "            ssize_t n=write(fd,bytes.data()+done,bytes.size()-done);"
  "            if(n<0&&errno==EINTR)continue;"
  "            if(n<=0)throw package_io_error(path,n<0?errno:EIO);"
  "            done+=size_t(n);"
  "        }"
  "        project_io::check(fsync(fd));"
  "        project_io::check(syscall(SYS_renameat2,dir.fd,temp.c_str(),dir.fd,name.c_str(),RENAME_NOREPLACE));"
  "        project_io::sync_dir(dir.fd);"
  "    }catch(...){unlinkat(dir.fd,temp.c_str(),0);throw;}"
  "}"
  "void install_packages(const char* folder,const char* store){"
  "    project_io::ProjectDirectory project(folder);project_io::acquire(project,true);"
  "    if(!project.prefix.empty())throw Failure{f_package_lock_error(decode(folder),U\"Expected a project directory\"),0};"
  "    auto lock=*read_package_lock(project,true);"
  "    InputFD source(open(store,O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW));"
  "    if(source.fd<0)throw package_io_error(store,errno);"
  "    std::vector<std::pair<std::string,Text>> missing;"
  "    size_t total=0;"
  "    for(const auto& key:lock.v_paths){"
  "        auto path=encode(key);"
  "        auto error=[&](int code){return package_io_error(path,code);};"
  "        auto data=read_import_at(source.fd,path.substr(7),error);"
  "        total+=size_t(data.second);"
  "        if(total>8388608)throw Failure{f_package_lock_error(key,U\"Package installation exceeds 8 MiB\"),0};"
  "        f_verify_package_source(lock,key,data.first);"
  "        try{"
  "            auto installed=read_import_at(project.fd.fd,path,[](int code){return std::system_error(code,std::generic_category());});"
  "            f_verify_package_source(lock,key,installed.first);"
  "        }catch(const std::system_error& e){"
  "            if(e.code().value()!=ENOENT)throw error(e.code().value());"
  "            missing.emplace_back(path,std::move(data.first));"
  "        }"
  "    }"
  "    for(const auto& [path,contents]:missing)publish_package_source(project.fd.fd,path,contents);"
  "    std::cout<<\"{\\\"verified\\\":\"<<lock.v_paths.size()<<\",\\\"installed\\\":\"<<missing.size()<<\"}\\n\";"
  "}"
fold rows "" code row line concat code (concat line "\n")
