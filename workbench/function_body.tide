{"inputs":{"files":[{"file":"other.tide","source":"h > i\n1"},{"file":"lib.tide","source":"use a\r\n\r\nf > t\r\n(concat \"猫)\" \"(\\\"x\" \t\r\n\r\ng > i\r\n12"}],"edits":[{"name":"f","body":"1"},{"name":"g","body":"12"}],"diagnostic":{"file":"lib.tide","code":"E_SYNTAX","message":"Missing operand","line":4,"column":20}},"expect":{"none":true}}

example require_corresponding_file closing_retry
{"inputs":{"files":[{"file":"other.tide","source":"h > i\n1"},{"file":"lib.tide","source":"use a\r\n\r\nf > t\r\n(concat \"猫)\" \"(\\\"x\" \t\r\n\r\ng > i\r\n12"}],"edits":[{"name":"f","body":"(concat \"猫)\" \"(\\\"x\" \t\r\n"},{"name":"g","body":"12"}],"diagnostic":{"file":"missing.tide","code":"E_SYNTAX","message":"Missing operand","line":4,"column":20}},"expect":{"none":true}}

example require_end_position closing_retry
{"inputs":{"files":[{"file":"other.tide","source":"h > i\n1"},{"file":"lib.tide","source":"use a\r\n\r\nf > t\r\n(concat \"猫)\" \"(\\\"x\" \t\r\n\r\ng > i\r\n12"}],"edits":[{"name":"f","body":"(concat \"猫)\" \"(\\\"x\" \t\r\n"},{"name":"g","body":"12"}],"diagnostic":{"file":"lib.tide","code":"E_SYNTAX","message":"Missing operand","line":4,"column":4}},"expect":{"none":true}}

example skip_nonheader closing_retry
{"inputs":{"files":[{"file":"lib.tide","source":"f > i\n+ 1\nf 1\n(+ 2 3"}],"edits":[{"name":"f","body":"(+ 2 3"}],"diagnostic":{"file":"lib.tide","code":"E_SYNTAX","message":"Missing operand","line":4,"column":7}},"expect":{"none":true}}

example first_definition_retry closing_retry
{"inputs":{"files":[{"file":"lib.tide","source":"f > i\n(+ 1 2"}],"edits":[{"name":"f","body":"(+ 1 2"}],"diagnostic":{"file":"lib.tide","code":"E_SYNTAX","message":"Missing operand","line":2,"column":7}},"expect":{"some":[{"name":"f","body":"(+ 1 2)"}]}}

example two_modules candidate_files
{"inputs":{"files":[{"file":"a.tide","source":"f > i\r\n1\r\n\r\nother > i\r\n4\r\n"},{"file":"b.tide","source":"g > i\n2"}],"forms":[{"name":"f","file":"a.tide","body":"1"},{"name":"g","file":"b.tide","body":"2"}],"edits":[{"name":"g","body":"8"},{"name":"f","body":"(+ 1 2)"}]},"expect":[{"file":"a.tide","source":"f > i\r\n(+ 1 2)\r\n\r\nother > i\r\n4\r\n"},{"file":"b.tide","source":"g > i\n8"}]}

